pkgname=feishin-native-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc="Native Rust build of Feishin, a self-hosted music player for Navidrome, Subsonic and Jellyfin"
arch=('x86_64' 'aarch64')
url="https://github.com/DouglasMarq/feishin"
license=('GPL-3.0-only')
depends=('mpv' 'fontconfig' 'gcc-libs' 'glibc' 'hicolor-icon-theme' 'libglvnd' 'libxkbcommon'
         'libxkbcommon-x11' 'wayland' 'libx11' 'libxcursor' 'libxi' 'libxrandr')
makedepends=('cargo' 'git' 'pkgconf')
provides=('feishin-native')
conflicts=('feishin' 'feishin-bin' 'feishin-git' 'feishin-appimage')
options=('!lto' '!debug')
source=("feishin::${FEISHIN_SOURCE:-git+https://github.com/DouglasMarq/feishin.git#branch=feat/rust-native}")
sha256sums=('SKIP')

pkgver() {
    cd feishin/rust
    local workspace_version
    workspace_version="$(sed -n 's/^version = "\(.*\)"$/\1/p' Cargo.toml | head -n1)"
    printf "%s.r%s.g%s" "$workspace_version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
    cd feishin/rust
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
    cd feishin/rust
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
    cargo build --frozen --release -p feishin
}

package() {
    cd feishin/rust
    install -Dm755 target/release/feishin "$pkgdir/usr/bin/feishin"
    bash packaging/install-desktop-integration.sh "$pkgdir/usr"
}
