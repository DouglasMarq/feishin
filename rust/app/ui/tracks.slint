import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { TracksState } from "globals.slint";
import { ShareState } from "share.slint";
import { TrackRowView } from "track_row.slint";
import { TracksHeader } from "tracks_header.slint";
import { TracksToolbar } from "tracks_toolbar.slint";

export { Cell, HeaderCell, Skeleton } from "track_cells.slint";
export { TrackRowView } from "track_row.slint";

export component TracksView inherits Rectangle {
    callback row-clicked();
    min-width: 320px;
    background: Theme.panel;

    init => {
        TracksState.load-genres();
    }

    keys := FocusScope {
        key-pressed(event) => {
            if ((event.modifiers.control || event.modifiers.meta) && (event.text == "a" || event.text == "A")) {
                TracksState.select-all();
                return accept;
            }
            if (event.text == Key.Escape && TracksState.selected-count > 0) {
                TracksState.clear-selection();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            TracksToolbar {
                available-width: root.width;
            }

            TracksHeader {
                content-x: list.content-x;
            }

            list-area := Rectangle {
                min-width: 0px;
                vertical-stretch: 1;
                clip: true;

                row-menu := ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: @tr("Play");
                            enabled: TracksState.selected-count > 0;
                            activated => {
                                TracksState.play-selected();
                            }
                        }

                        MenuItem {
                            title: @tr("Play next");
                            enabled: TracksState.selected-count > 0;
                            activated => {
                                TracksState.queue-selected(true);
                            }
                        }

                        MenuItem {
                            title: @tr("Add to queue");
                            enabled: TracksState.selected-count > 0;
                            activated => {
                                TracksState.queue-selected(false);
                            }
                        }

                        MenuSeparator { }

                        MenuItem {
                            title: @tr("Add to playlist");
                            enabled: TracksState.selected-count > 0;
                            activated => {
                                TracksState.add-selected-to-playlist();
                            }
                        }

                        MenuItem {
                            title: ShareState.menu-title;
                            enabled: ShareState.is-available && !ShareState.is-busy && TracksState.selected-count > 0;
                            activated => {
                                ShareState.share-selected-tracks();
                            }
                        }

                        MenuSeparator { }

                        MenuItem {
                            title: @tr("Add to favorites");
                            enabled: TracksState.selected-count > 0;
                            activated => {
                                TracksState.favorite-selected(true);
                            }
                        }

                        MenuItem {
                            title: @tr("Remove from favorites");
                            enabled: TracksState.selected-count > 0;
                            activated => {
                                TracksState.favorite-selected(false);
                            }
                        }

                        Menu {
                            title: @tr("Set rating");
                            enabled: TracksState.selected-count > 0;

                            MenuItem {
                                title: @tr("No rating");
                                activated => {
                                    TracksState.rate-selected(0);
                                }
                            }

                            MenuItem {
                                title: @tr("1 star");
                                activated => {
                                    TracksState.rate-selected(1);
                                }
                            }

                            MenuItem {
                                title: @tr("2 stars");
                                activated => {
                                    TracksState.rate-selected(2);
                                }
                            }

                            MenuItem {
                                title: @tr("3 stars");
                                activated => {
                                    TracksState.rate-selected(3);
                                }
                            }

                            MenuItem {
                                title: @tr("4 stars");
                                activated => {
                                    TracksState.rate-selected(4);
                                }
                            }

                            MenuItem {
                                title: @tr("5 stars");
                                activated => {
                                    TracksState.rate-selected(5);
                                }
                            }
                        }

                        MenuSeparator { }

                        MenuItem {
                            title: @tr("Go to album");
                            enabled: TracksState.selected-count == 1;
                            activated => {
                                TracksState.go-to-album();
                            }
                        }

                        MenuItem {
                            title: @tr("Go to artist");
                            enabled: TracksState.selected-count == 1;
                            activated => {
                                TracksState.go-to-artist();
                            }
                        }
                    }

                    list := ListView {
                        for row in TracksState.rows: TrackRowView {
                            track: row;
                            clicked => {
                                root.row-clicked();
                                keys.focus();
                            }
                            play => {
                                root.row-clicked();
                                TracksState.play-row(row.index - 1);
                            }
                            select(toggle, extend) => {
                                TracksState.select-row(row.index - 1, toggle, extend);
                            }
                            context-menu(pointer-x, pointer-y) => {
                                TracksState.context-row(row.index - 1);
                                row-menu.show({ x: pointer-x - list-area.absolute-position.x, y: pointer-y - list-area.absolute-position.y });
                            }
                            toggle-favorite => {
                                TracksState.toggle-favorite(row.index - 1);
                            }
                            rate(value) => {
                                TracksState.rate-row(row.index - 1, value);
                            }
                        }
                    }
                }

                if !TracksState.is-loading && TracksState.total == 0: Text {
                    text: @tr("No tracks found");
                    color: Theme.muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }
}
