import { ListView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { Actions, AppState, PlayerState, Route, TrackRow } from "globals.slint";
import { Icon, IconButton, TooltipAnchor } from "widgets.slint";
import { Cell, LinkCell, Skeleton } from "track_cells.slint";
import { ShareKind, ShareState } from "share.slint";

export struct FolderCrumb {
    id: string,
    name: string,
}

export struct FolderListRow {
    is-folder: bool,
    folder-id: string,
    name: string,
    track: TrackRow,
}

export enum FolderPlayMode { now, next, last, shuffle }

export enum FolderSongAction { play-next, add-to-queue }

export global FoldersState {
    in property <[FolderCrumb]> crumbs;
    in property <[FolderListRow]> rows;
    in property <string> folder-id;
    in property <string> name;
    in property <string> summary;
    in property <bool> loading;
    in property <string> error;
    callback load(detail-id: string);
    callback open(folder-id: string, name: string);
    callback play-folder(folder-id: string, mode: FolderPlayMode);
    callback play-row(row-index: int);
    callback song-action(row-index: int, action: FolderSongAction);
}

global FolderColumns {
    out property <length> index: 56px;
    out property <length> artist: 200px;
    out property <length> album: 220px;
    out property <length> duration: 72px;
}

component CrumbLink inherits Rectangle {
    in property <FolderCrumb> crumb;
    in property <bool> current;
    width: label.preferred-width + 8px;

    label := Text {
        x: 4px;
        text: root.crumb.name;
        color: root.current ? Theme.foreground : (touch.has-hover ? Theme.foreground : Theme.muted);
        font-weight: root.current ? 600 : 400;
        vertical-alignment: center;
    }

    TooltipAnchor {
        text: root.current ? @tr("You are here: {}", root.crumb.name) : @tr("Go back to {}", root.crumb.name);
        hovered: touch.has-hover;
    }

    touch := TouchArea {
        mouse-cursor: root.current ? default : pointer;
        clicked => {
            if (!root.current) {
                AppState.navigate(Route.folders, root.crumb.id);
            }
        }
    }
}

component Breadcrumbs inherits HorizontalLayout {
    spacing: 2px;
    alignment: start;
    height: 24px;

    for crumb[crumb-index] in FoldersState.crumbs: HorizontalLayout {
        spacing: 2px;

        if crumb-index > 0: Text {
            text: "/";
            color: Theme.muted;
            vertical-alignment: center;
        }

        CrumbLink {
            crumb: crumb;
            current: crumb-index == FoldersState.crumbs.length - 1;
        }
    }
}

component FolderRowView inherits Rectangle {
    in property <FolderListRow> item;
    height: 36px;
    background: touch.has-hover ? Theme.hover : transparent;

    TooltipAnchor {
        text: @tr("Open {}", root.item.name);
        hovered: touch.has-hover;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            FoldersState.open(root.item.folder-id, root.item.name);
        }

        ContextMenuArea {
            Menu {
                MenuItem {
                    title: @tr("Open");
                    activated => {
                        FoldersState.open(root.item.folder-id, root.item.name);
                    }
                }

                MenuSeparator { }

                MenuItem {
                    title: @tr("Play");
                    activated => {
                        FoldersState.play-folder(root.item.folder-id, FolderPlayMode.now);
                    }
                }

                MenuItem {
                    title: @tr("Shuffle");
                    activated => {
                        FoldersState.play-folder(root.item.folder-id, FolderPlayMode.shuffle);
                    }
                }

                MenuItem {
                    title: @tr("Play next");
                    activated => {
                        FoldersState.play-folder(root.item.folder-id, FolderPlayMode.next);
                    }
                }

                MenuItem {
                    title: @tr("Add to queue");
                    activated => {
                        FoldersState.play-folder(root.item.folder-id, FolderPlayMode.last);
                    }
                }
            }

            HorizontalLayout {
                padding-right: 12px;

                Rectangle {
                    width: FolderColumns.index;

                    Icon {
                        x: parent.width - 16px - self.width;
                        path: Icons.folder;
                        color: Theme.muted;
                        width: 18px;
                        height: 18px;
                    }
                }

                Cell {
                    horizontal-stretch: 1;
                    text: root.item.name;
                    text-color: Theme.foreground;
                }

                HorizontalLayout {
                    width: 72px;
                    alignment: end;

                    if touch.has-hover: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.play;
                        tooltip: @tr("Play {} with its subfolders", root.item.name);
                        clicked => {
                            FoldersState.play-folder(root.item.folder-id, FolderPlayMode.now);
                        }
                    }
                }
            }
        }
    }
}

component SongMenu inherits ContextMenuArea {
    in property <FolderListRow> item;
    in property <int> row-index;

    Menu {
        MenuItem {
            title: @tr("Play");
            activated => {
                FoldersState.play-row(root.row-index);
            }
        }

        MenuItem {
            title: @tr("Play next");
            activated => {
                FoldersState.song-action(root.row-index, FolderSongAction.play-next);
            }
        }

        MenuItem {
            title: @tr("Add to queue");
            activated => {
                FoldersState.song-action(root.row-index, FolderSongAction.add-to-queue);
            }
        }

        MenuSeparator { }

        MenuItem {
            title: @tr("Add to playlist");
            activated => {
                Actions.add-to-playlist([root.item.track.id]);
            }
        }

        MenuItem {
            title: ShareState.menu-title;
            enabled: ShareState.available && !ShareState.busy;
            activated => {
                ShareState.share(ShareKind.song, root.item.track.id, root.item.track.title);
            }
        }

        MenuSeparator { }

        MenuItem {
            title: @tr("Go to album");
            enabled: root.item.track.album-id != "";
            activated => {
                AppState.navigate(Route.album-detail, root.item.track.album-id);
            }
        }

        MenuItem {
            title: @tr("Go to artist");
            enabled: root.item.track.artist-id != "";
            activated => {
                AppState.navigate(Route.artist-detail, root.item.track.artist-id);
            }
        }
    }
}

component SongRowView inherits Rectangle {
    in property <FolderListRow> item;
    in property <int> row-index;
    property <bool> playing: root.item.track.loaded && root.item.track.id == PlayerState.song-id;
    height: 36px;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        double-clicked => {
            if (root.item.track.loaded) {
                FoldersState.play-row(root.row-index);
            }
        }

        SongMenu {
            enabled: root.item.track.loaded;
            item: root.item;
            row-index: root.row-index;

            HorizontalLayout {
                padding-right: 12px;

                Rectangle {
                    width: FolderColumns.index;

                    if !touch.has-hover && !root.playing: Text {
                        x: 0;
                        width: parent.width - 16px;
                        text: root.item.track.index;
                        color: Theme.muted;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    if !touch.has-hover && root.playing: Icon {
                        x: parent.width - 16px - self.width;
                        path: Icons.note;
                        color: Theme.primary;
                        width: 16px;
                        height: 16px;
                    }

                    if touch.has-hover && root.item.track.loaded: IconButton {
                        x: parent.width - 12px - self.width;
                        y: (parent.height - self.height) / 2;
                        width: 28px;
                        height: 28px;
                        icon: Icons.play;
                        icon-size: 18px;
                        tooltip: @tr("Play from {}", root.item.track.title);
                        clicked => {
                            FoldersState.play-row(root.row-index);
                        }
                    }
                }

                if root.item.track.loaded: Cell {
                    horizontal-stretch: 1;
                    text: root.item.track.title;
                    text-color: root.playing ? Theme.primary : Theme.foreground;
                }

                if !root.item.track.loaded: Rectangle {
                    horizontal-stretch: 1;

                    Skeleton {
                        x: 8px;
                        width: parent.width * 0.5;
                    }
                }

                LinkCell {
                    width: FolderColumns.artist;
                    text: root.item.track.artists;
                    enabled: root.item.track.artist-id != "";
                    clicked => {
                        AppState.navigate(Route.artist-detail, root.item.track.artist-id);
                    }
                }

                LinkCell {
                    width: FolderColumns.album;
                    text: root.item.track.album;
                    enabled: root.item.track.album-id != "";
                    clicked => {
                        AppState.navigate(Route.album-detail, root.item.track.album-id);
                    }
                }

                Cell {
                    width: FolderColumns.duration;
                    text: root.item.track.duration;
                }
            }
        }
    }
}

component FolderActions inherits HorizontalLayout {
    spacing: 8px;
    alignment: start;

    IconButton {
        width: 40px;
        height: 40px;
        icon: Icons.play;
        icon-size: 24px;
        enabled: !FoldersState.loading;
        tooltip: @tr("Play every song in {} and its subfolders", FoldersState.name);
        clicked => {
            FoldersState.play-folder(FoldersState.folder-id, FolderPlayMode.now);
        }
    }

    IconButton {
        width: 40px;
        height: 40px;
        icon: Icons.shuffle;
        icon-size: 24px;
        enabled: !FoldersState.loading;
        tooltip: @tr("Shuffle every song in {} and its subfolders", FoldersState.name);
        clicked => {
            FoldersState.play-folder(FoldersState.folder-id, FolderPlayMode.shuffle);
        }
    }

    IconButton {
        width: 40px;
        height: 40px;
        icon: Icons.next;
        icon-size: 24px;
        enabled: !FoldersState.loading;
        tooltip: @tr("Play {} next", FoldersState.name);
        clicked => {
            FoldersState.play-folder(FoldersState.folder-id, FolderPlayMode.next);
        }
    }

    IconButton {
        width: 40px;
        height: 40px;
        icon: Icons.queue;
        icon-size: 24px;
        enabled: !FoldersState.loading;
        tooltip: @tr("Add {} to the queue", FoldersState.name);
        clicked => {
            FoldersState.play-folder(FoldersState.folder-id, FolderPlayMode.last);
        }
    }

    Text {
        text: FoldersState.summary;
        color: Theme.muted;
        vertical-alignment: center;
    }
}

export component FoldersView inherits Rectangle {
    property <string> id: AppState.detail-id;
    min-width: 320px;
    background: Theme.background;

    init => {
        FoldersState.load(root.id);
    }

    changed id => {
        list.content-y = 0;
        FoldersState.load(root.id);
    }

    VerticalLayout {
        VerticalLayout {
            vertical-stretch: 0;
            padding: 20px;
            padding-bottom: 12px;
            spacing: 10px;

            Text {
                text: FoldersState.name;
                font-size: 24px;
                font-weight: 700;
                color: Theme.foreground;
                overflow: elide;
            }

            Breadcrumbs { }

            FolderActions { }
        }

        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        Rectangle {
            vertical-stretch: 1;

            list := ListView {
                for row[row-index] in FoldersState.rows: Rectangle {
                    height: 36px;

                    if row.is-folder: FolderRowView {
                        item: row;
                    }

                    if !row.is-folder: SongRowView {
                        item: row;
                        row-index: row-index;
                    }
                }
            }

            if FoldersState.loading && FoldersState.rows.length == 0: VerticalLayout {
                alignment: start;

                for placeholder in 8: Rectangle {
                    height: 36px;

                    Skeleton {
                        x: 72px;
                        width: min(260px, parent.width * 0.5);
                    }
                }
            }

            if !FoldersState.loading && FoldersState.rows.length == 0: Text {
                text: FoldersState.error != "" ? FoldersState.error : @tr("This folder is empty");
                color: Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}
