import { ListView } from "std-widgets.slint";
import { Motion, Behaviour, Theme, Icons } from "theme.slint";
import { QueueState } from "globals.slint";
import { Icon, IconButton, TooltipAnchor } from "widgets.slint";
import { SettingsState } from "settings.slint";

export component QueuePanel inherits Rectangle {
    property <length> row-height: 48px;
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    property <string> current-uid: QueueState.current-uid;
    width: 340px;
    border-radius: Theme.radius-panel;
    background: Theme.panel;
    clip: true;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow;

    init => {
        self.reveal-current();
    }
    changed current-uid => {
        self.reveal-current();
    }

    function reveal-current() {
        if (!SettingsState.is-following-current-song || QueueState.current-position < 0) {
            return;
        }
        let row-top = QueueState.current-position * root.row-height;
        if (row-top >= -list.content-y && row-top + root.row-height <= list.visible-height - list.content-y) {
            return;
        }
        list.content-y = max(min(0px, list.visible-height - list.content-height), min(0px, (list.visible-height - root.row-height) / 2 - row-top));
    }

    VerticalLayout {

        HorizontalLayout {
            padding: 16px;
            spacing: 8px;

            Text {
                text: @tr("Queue");
                font-size: 16px;
                font-weight: 700;
                color: Theme.foreground;
                vertical-alignment: center;
            }

            Text {
                text: QueueState.rows.length;
                color: Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        list := ListView {
            for row[row-index] in QueueState.rows: Rectangle {
                height: root.row-height;
                background: row.is-current ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);

                animate background {
                    duration: Motion.quick;
                }

                touch := TouchArea {
                    double-clicked => {
                        QueueState.play(row.uid);
                    }
                    moved => {
                        if (self.pressed && abs(self.mouse-y - self.pressed-y) > Behaviour.drag-threshold) {
                            root.drag-from = row-index;
                            root.drag-to = max(0, min(QueueState.rows.length - 1, row-index + Math.round((self.mouse-y - self.pressed-y) / root.row-height)));
                        }
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            if (event.kind == PointerEventKind.up && root.drag-from == row-index && root.drag-to != row-index && root.drag-to >= 0) {
                                QueueState.move(row-index, root.drag-to);
                            }
                            root.drag-from = -1;
                            root.drag-to = -1;
                        }
                    }

                    TooltipAnchor {
                        text: @tr("Double-click to play, drag to reorder");
                        is-hovered: touch.has-hover && root.drag-from < 0;
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 8px;

                        if row.is-current: Icon {
                            y: (parent.height - self.height) / 2;
                            path: Icons.note;
                            color: Theme.primary;
                            width: 16px;
                            height: 16px;
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: row.title;
                                color: row.is-current ? Theme.primary : Theme.foreground;
                                overflow: elide;
                            }

                            Text {
                                text: row.artists;
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: row.duration;
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.close;
                            icon-size: 16px;
                            tooltip: @tr("Remove from queue");
                            width: 28px;
                            height: 28px;
                            opacity: touch.has-hover ? 1 : 0;
                            clicked => {
                                QueueState.remove(row.uid);
                            }
                        }
                    }
                }

                if root.drag-from >= 0 && root.drag-to == row-index && root.drag-from != row-index: Rectangle {
                    y: root.drag-to > root.drag-from ? parent.height - 2px : 0;
                    height: 2px;
                    background: Theme.primary;
                }
            }
        }
    }
}
