import { ListView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { QueueState } from "globals.slint";
import { Icon, IconButton } from "widgets.slint";

export component QueuePanel inherits Rectangle {
    property <length> row-height: 48px;
    property <int> drag-from: -1;
    property <int> drag-to: -1;
    width: 340px;
    background: Theme.background-alt;

    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.border;
    }

    VerticalLayout {
        padding-left: 1px;

        HorizontalLayout {
            padding: 16px;
            spacing: 8px;

            Text {
                text: "Queue";
                font-size: 16px;
                font-weight: 700;
                color: Theme.foreground;
                vertical-alignment: center;
            }

            Text {
                text: QueueState.rows.length;
                color: Theme.muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }

        ListView {
            for row[i] in QueueState.rows: Rectangle {
                height: root.row-height;
                background: row.current ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);

                touch := TouchArea {
                    double-clicked => {
                        QueueState.play(row.uid);
                    }
                    moved => {
                        if (self.pressed && abs(self.mouse-y - self.pressed-y) > 6px) {
                            root.drag-from = i;
                            root.drag-to = max(0, min(QueueState.rows.length - 1, i + Math.round((self.mouse-y - self.pressed-y) / root.row-height)));
                        }
                    }
                    pointer-event(event) => {
                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            if (event.kind == PointerEventKind.up && root.drag-from == i && root.drag-to != i && root.drag-to >= 0) {
                                QueueState.move(i, root.drag-to);
                            }
                            root.drag-from = -1;
                            root.drag-to = -1;
                        }
                    }

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 8px;
                        spacing: 8px;

                        if row.current: Icon {
                            y: (parent.height - self.height) / 2;
                            path: Icons.note;
                            color: Theme.primary;
                            width: 16px;
                            height: 16px;
                        }

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;

                            Text {
                                text: row.title;
                                color: row.current ? Theme.primary : Theme.foreground;
                                overflow: elide;
                            }

                            Text {
                                text: row.artists;
                                color: Theme.muted;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }

                        Text {
                            text: row.duration;
                            color: Theme.muted;
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        IconButton {
                            y: (parent.height - self.height) / 2;
                            icon: Icons.close;
                            icon-size: 16px;
                            tooltip: "Remove from queue";
                            width: 28px;
                            height: 28px;
                            opacity: touch.has-hover ? 1 : 0;
                            clicked => {
                                QueueState.remove(row.uid);
                            }
                        }
                    }
                }

                if root.drag-from >= 0 && root.drag-to == i && root.drag-from != i: Rectangle {
                    y: root.drag-to > root.drag-from ? parent.height - 2px : 0;
                    height: 2px;
                    background: Theme.primary;
                }
            }
        }
    }
}
