export struct TrackRow {
    id: string,
    index: int,
    title: string,
    artists: string,
    album: string,
    duration: string,
    year: string,
    plays: string,
    loaded: bool,
    playing: bool,
    album-id: string,
    artist-id: string,
    favorite: bool,
    rating: int,
    selected: bool,
}

export struct QueueRow {
    uid: string,
    title: string,
    artists: string,
    duration: string,
    current: bool,
}

export enum Page { loading, login, main }

export enum Route { home, tracks, albums, album-detail, artists, artist-detail, genres, playlists, playlist-detail, favorites, search, settings, now-playing }

export global AppState {
    in-out property <Page> page: Page.loading;
    in-out property <bool> queue-open: true;
    in-out property <string> status;
    in property <string> server-name;
    in property <Route> route: Route.tracks;
    in property <string> detail-id;
    in property <bool> can-go-back;
    callback navigate(route: Route, detail-id: string);
    callback back();
}

export global Actions {
    callback add-to-playlist(song-ids: [string]);
}

export global LoginState {
    in-out property <int> server-type;
    in-out property <string> url;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> busy;
    in-out property <string> error;
    callback login();
    callback import-feishin();
}

export global TracksState {
    in property <[TrackRow]> rows;
    in property <int> total;
    in property <bool> loading;
    in-out property <string> sort-column: "title";
    in-out property <bool> sort-desc;
    in-out property <length> w-index: 56px;
    in-out property <length> w-title: 320px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 240px;
    in-out property <length> w-year: 64px;
    in-out property <length> w-plays: 64px;
    in-out property <length> w-duration: 72px;
    callback search-edited(string);
    callback sort-by(string);
    callback play-row(int);
    in-out property <bool> show-artist: true;
    in-out property <bool> show-album: true;
    in-out property <bool> show-year: true;
    in-out property <bool> show-plays: true;
    in-out property <bool> show-duration: true;
    in-out property <bool> show-favorite: true;
    in-out property <bool> show-rating: true;
    in-out property <length> w-favorite: 44px;
    in-out property <length> w-rating: 104px;
    in-out property <string> search-text;
    in-out property <bool> filter-favorite;
    in property <[string]> genres: ["All genres"];
    in property <[string]> genre-ids;
    in-out property <int> genre-index;
    in-out property <string> year-from;
    in-out property <string> year-to;
    in property <int> selected-count;
    callback filters-changed(debounced: bool);
    callback load-genres();
    callback select-row(row-index: int, ctrl-held: bool, shift-held: bool);
    callback context-row(row-index: int);
    callback play-selected();
    callback queue-selected(play-next: bool);
    callback add-selected-to-playlist();
    callback favorite-selected(bool);
    callback rate-selected(int);
    callback go-to-album();
    callback go-to-artist();
    callback toggle-favorite(int);
    callback rate-row(int, int);
}

export global PlayerState {
    in property <bool> has-song;
    in property <string> song-id;
    in property <string> title;
    in property <string> artists;
    in property <string> album;
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> playing;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <int> volume: 70;
    in property <bool> muted;
    in property <bool> shuffle;
    in property <int> repeat;
    in property <bool> sleep-active;
    in property <string> sleep-label;
    callback start-sleep-timer(minutes: int);
    callback cancel-sleep-timer();
    callback toggle-pause();
    callback next();
    callback previous();
    callback seek(int);
    callback set-volume(int);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
}

export global QueueState {
    in property <[QueueRow]> rows;
    callback play(string);
    callback remove(string);
    callback move(int, int);
}
