export struct TrackRow {
    id: string,
    index: int,
    title: string,
    artists: string,
    album: string,
    duration: string,
    year: string,
    plays: string,
    is-loaded: bool,
    is-playing: bool,
    album-id: string,
    artist-id: string,
    is-favorite: bool,
    rating: int,
    is-selected: bool,
}

export struct QueueRow {
    uid: string,
    title: string,
    artists: string,
    duration: string,
    is-current: bool,
}

export enum Page { loading, login, main }

export enum Route { home, tracks, albums, album-detail, artists, artist-detail, genres, playlists, playlist-detail, favorites, search, settings, now-playing, folders, radio, discover }

export global AppState {
    in-out property <Page> page: Page.loading;
    in-out property <bool> is-queue-open: true;
    in-out property <string> status;
    in property <string> server-name;
    in property <bool> is-library-scanning;
    in property <string> library-scan-progress;
    callback rescan-library();
    in property <Route> route: Route.tracks;
    in property <string> detail-id;
    in property <bool> can-go-back;
    in property <bool> has-inset-title-bar;
    callback navigate(route: Route, detail-id: string);
    callback back();
}

export global Actions {
    callback add-to-playlist(song-ids: [string]);
}

export enum ServerKind { navidrome, subsonic, jellyfin }

export global LoginState {
    in-out property <ServerKind> server-type;
    in-out property <string> url;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <bool> is-busy;
    in-out property <string> error;
    callback login();
    callback import-feishin();
}

export enum TrackColumn { index, title, artist, album, year, plays, duration, favorite, rating }

export global TracksState {
    in property <[TrackRow]> rows;
    in property <int> total;
    in property <bool> is-loading;
    in-out property <TrackColumn> sort-column: TrackColumn.title;
    in-out property <bool> is-sort-descending;
    in-out property <length> w-index: 56px;
    in-out property <length> w-title: 300px;
    in-out property <length> w-artist: 200px;
    in-out property <length> w-album: 240px;
    in-out property <length> w-year: 64px;
    in-out property <length> w-plays: 64px;
    in-out property <length> w-duration: 72px;
    callback search-edited(text: string);
    callback sort-by(column: TrackColumn);
    callback play-row(row-index: int);
    in-out property <bool> is-artist-shown: true;
    in-out property <bool> is-album-shown: true;
    in-out property <bool> is-year-shown: true;
    in-out property <bool> is-plays-shown: true;
    in-out property <bool> is-duration-shown: true;
    in-out property <bool> is-favorite-shown: true;
    in-out property <bool> is-rating-shown: true;
    in-out property <length> w-favorite: 44px;
    in-out property <length> w-rating: 104px;
    out property <length> min-flexible-width: 80px;
    out property <length> trailing-gap: 16px;

    pure function is-flexible(column: TrackColumn) -> bool {
        return column == TrackColumn.title || column == TrackColumn.artist || column == TrackColumn.album;
    }

    pure function saved-width(column: TrackColumn) -> length {
        if (column == TrackColumn.index) {
            return self.w-index;
        } else if (column == TrackColumn.title) {
            return self.w-title;
        } else if (column == TrackColumn.artist) {
            return self.w-artist;
        } else if (column == TrackColumn.album) {
            return self.w-album;
        } else if (column == TrackColumn.year) {
            return self.w-year;
        } else if (column == TrackColumn.plays) {
            return self.w-plays;
        } else if (column == TrackColumn.duration) {
            return self.w-duration;
        } else if (column == TrackColumn.favorite) {
            return self.w-favorite;
        }
        return self.w-rating;
    }

    function save-width(column: TrackColumn, width: length) {
        if (column == TrackColumn.index) {
            self.w-index = width;
        } else if (column == TrackColumn.title) {
            self.w-title = width;
        } else if (column == TrackColumn.artist) {
            self.w-artist = width;
        } else if (column == TrackColumn.album) {
            self.w-album = width;
        } else if (column == TrackColumn.year) {
            self.w-year = width;
        } else if (column == TrackColumn.plays) {
            self.w-plays = width;
        } else if (column == TrackColumn.duration) {
            self.w-duration = width;
        } else if (column == TrackColumn.favorite) {
            self.w-favorite = width;
        } else {
            self.w-rating = width;
        }
    }

    pure function fixed-columns-width() -> length {
        return self.w-index + (self.is-year-shown ? self.w-year : 0px) + (self.is-plays-shown ? self.w-plays : 0px) + (self.is-duration-shown ? self.w-duration : 0px) + (self.is-favorite-shown ? self.w-favorite : 0px) + (self.is-rating-shown ? self.w-rating : 0px);
    }

    pure function flexible-columns-width() -> length {
        return self.w-title + (self.is-artist-shown ? self.w-artist : 0px) + (self.is-album-shown ? self.w-album : 0px);
    }

    pure function flexible-space(list-width: length) -> length {
        return list-width - self.trailing-gap - self.fixed-columns-width();
    }

    pure public function shown-width(column: TrackColumn, list-width: length) -> length {
        if (!self.is-flexible(column) || list-width <= 0px) {
            return self.saved-width(column);
        }
        return max(self.min-flexible-width, self.saved-width(column) * (self.flexible-space(list-width) / self.flexible-columns-width()));
    }

    public function resize(column: TrackColumn, width: length, list-width: length) {
        if (!self.is-flexible(column) || list-width <= 0px) {
            self.save-width(column, width);
            return;
        }
        let others = self.flexible-columns-width() - self.saved-width(column);
        let left-over = self.flexible-space(list-width) - width;
        if (others <= 0px) {
            self.save-width(column, width);
        } else if (left-over >= self.min-flexible-width) {
            self.save-width(column, others * (width / left-over));
        }
    }
    in-out property <string> search-text;
    in-out property <bool> is-favorite-filter-on;
    in property <[string]> genres: [@tr("All genres")];
    in property <[string]> genre-ids;
    in-out property <int> genre-index;
    in-out property <string> year-from;
    in-out property <string> year-to;
    in property <int> selected-count;
    callback filters-changed(is-debounced: bool);
    callback load-genres();
    callback select-row(row-index: int, is-control-held: bool, is-shift-held: bool);
    callback context-row(row-index: int);
    callback select-all();
    callback clear-selection();
    callback play-selected();
    callback queue-selected(is-play-next: bool);
    callback add-selected-to-playlist();
    callback favorite-selected(is-favorite: bool);
    callback rate-selected(rating: int);
    callback go-to-album();
    callback go-to-artist();
    callback toggle-favorite(row-index: int);
    callback rate-row(row-index: int, rating: int);
}

export enum RepeatState { off, all, one }

export global PlayerState {
    in property <color> tint;
    in property <bool> has-tint;
    in property <bool> has-song;
    in property <string> song-id;
    in property <string> title;
    in property <string> artists;
    in property <string> album;
    in property <image> cover;
    in property <bool> has-cover;
    in property <bool> is-playing;
    in property <int> position-ms;
    in property <int> duration-ms;
    in property <int> volume: 70;
    in property <bool> is-muted;
    in property <bool> is-shuffled;
    in property <RepeatState> repeat;
    in property <bool> is-sleep-active;
    in property <string> sleep-label;
    callback start-sleep-timer(minutes: int);
    callback sleep-at-end-of-track();
    callback cancel-sleep-timer();
    callback toggle-pause();
    callback next();
    callback previous();
    callback seek(position-ms: int);
    callback set-volume(volume: int);
    callback toggle-mute();
    callback toggle-shuffle();
    callback cycle-repeat();
}

export global QueueState {
    in property <[QueueRow]> rows;
    in property <int> revision;
    in property <int> current-position: -1;
    in property <string> current-uid;
    callback play(uid: string);
    callback remove(uid: string);
    callback move(from-index: int, to-index: int);
}
