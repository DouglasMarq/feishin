import { Theme, Icons } from "theme.slint";
import { AppState, Route } from "globals.slint";
import { Icon, IconButton } from "widgets.slint";

component NavEntry inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: Theme.radius;
    background: root.active ? Theme.surface-raised : (touch.has-hover && root.enabled ? Theme.hover : transparent);
    opacity: root.enabled ? 1 : 0.4;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;

        Icon {
            y: (parent.height - self.height) / 2;
            path: root.icon;
            color: root.active ? Theme.primary : Theme.muted;
        }

        Text {
            text: root.label;
            color: root.active ? Theme.foreground : Theme.muted;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

export component Sidebar inherits Rectangle {
    width: 220px;
    background: Theme.background-alt;

    VerticalLayout {
        padding: 12px;
        spacing: 2px;

        HorizontalLayout {
            padding: 8px;
            padding-bottom: 16px;
            spacing: 10px;
            alignment: start;

            Icon {
                path: Icons.note;
                color: Theme.primary;
                width: 24px;
                height: 24px;
            }

            Text {
                text: "Feishin";
                font-size: 18px;
                font-weight: 700;
                color: Theme.foreground;
                vertical-alignment: center;
            }
        }

        Text {
            text: "LIBRARY";
            color: Theme.muted;
            font-size: 11px;
            font-weight: 600;
            height: 28px;
            vertical-alignment: center;
        }

        NavEntry {
            icon: Icons.home;
            label: "Home";
            active: AppState.route == Route.home;
            clicked => {
                AppState.navigate(Route.home, "");
            }
        }

        NavEntry {
            icon: Icons.note;
            label: "Tracks";
            active: AppState.route == Route.tracks;
            clicked => {
                AppState.navigate(Route.tracks, "");
            }
        }

        NavEntry {
            icon: Icons.album;
            label: "Albums";
            active: AppState.route == Route.albums || AppState.route == Route.album-detail;
            clicked => {
                AppState.navigate(Route.albums, "");
            }
        }

        NavEntry {
            icon: Icons.artist;
            label: "Artists";
            active: AppState.route == Route.artists || AppState.route == Route.artist-detail;
            clicked => {
                AppState.navigate(Route.artists, "");
            }
        }

        NavEntry {
            icon: Icons.genre;
            label: "Genres";
            active: AppState.route == Route.genres;
            clicked => {
                AppState.navigate(Route.genres, "");
            }
        }

        NavEntry {
            icon: Icons.playlist;
            label: "Playlists";
            active: AppState.route == Route.playlists || AppState.route == Route.playlist-detail;
            clicked => {
                AppState.navigate(Route.playlists, "");
            }
        }

        NavEntry {
            icon: Icons.folder;
            label: "Folders";
            enabled: false;
        }

        NavEntry {
            icon: Icons.heart;
            label: "Favorites";
            active: AppState.route == Route.favorites;
            clicked => {
                AppState.navigate(Route.favorites, "");
            }
        }

        NavEntry {
            icon: Icons.search;
            label: "Search";
            active: AppState.route == Route.search;
            clicked => {
                AppState.navigate(Route.search, "");
            }
        }

        Rectangle {
            vertical-stretch: 1;
        }

        NavEntry {
            icon: Icons.settings;
            label: "Settings";
            active: AppState.route == Route.settings;
            clicked => {
                AppState.navigate(Route.settings, "");
            }
        }

        HorizontalLayout {
            spacing: 4px;

            Text {
                horizontal-stretch: 1;
                text: AppState.server-name;
                color: Theme.muted;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }

            if AppState.server-name != "": IconButton {
                width: 24px;
                height: 24px;
                icon: Icons.refresh;
                icon-size: 16px;
                active: AppState.library-scanning;
                transform-rotation: AppState.library-scanning ? mod(animation-tick(), 1s) / 1s * 360deg : 0deg;
                tooltip: AppState.library-scanning ? (AppState.library-scan-progress == "" ? "Scanning the library for new content..." : "Scanning the library: " + AppState.library-scan-progress) : "Rescan the library for new content";
                clicked => {
                    if (!AppState.library-scanning) {
                        AppState.rescan-library();
                    }
                }
            }
        }
    }
}
