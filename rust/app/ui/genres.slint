import { LineEdit, ListView } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { AppState, PlayerState, Route, TrackRow, TracksState } from "globals.slint";
import { HeaderCell, Skeleton, TrackRowView } from "tracks.slint";
import { Icon, IconButton, TooltipAnchor } from "widgets.slint";

export enum GenresTab { albums, tracks }

export struct Card {
    id: string,
    title: string,
    subtitle: string,
    cover: image,
    has-cover: bool,
    is-favorite: bool,
    is-loaded: bool,
}

export struct CardRow {
    cards: [Card],
}

export struct TrackItem {
    track: TrackRow,
    is-favorite: bool,
}

export struct GenreRow {
    id: string,
    name: string,
    albums: string,
    tracks: string,
}

export global LibraryIcons {
    out property <string> heart-outline: "M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z";
    out property <string> arrow-back: "M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z";
}

export global GenresState {
    in property <[GenreRow]> genres;
    in property <bool> is-genres-loading;
    in property <string> title;
    in property <string> album-count;
    in property <string> track-count;
    in property <[CardRow]> albums;
    in property <bool> is-albums-loading;
    in property <[TrackItem]> tracks;
    in property <bool> is-tracks-loading;
    in-out property <GenresTab> tab;
    callback load(string);
    callback filter-edited(string);
    callback album-columns(int);
    callback play-track(int);
}

export component Tab inherits Rectangle {
    in property <string> text;
    in property <string> count;
    in property <bool> is-active;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.is-active;
    accessible-action-default => {
        root.clicked();
    }
    width: layout.preferred-width;
    height: 32px;
    border-radius: 16px;
    background: root.is-active ? Theme.surface-raised : (touch.has-hover ? Theme.hover : transparent);

    layout := HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 6px;

        Text {
            text: root.text;
            color: root.is-active ? Theme.foreground : Theme.muted;
            font-weight: 600;
            vertical-alignment: center;
        }

        if root.count != "": Text {
            text: root.count;
            color: Theme.muted;
            vertical-alignment: center;
        }
    }

    TooltipAnchor {
        text: root.is-active ? @tr("{} is shown", root.text) : @tr("Show {}", root.text);
        is-hovered: touch.has-hover;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component FavoriteButton inherits Rectangle {
    in property <bool> is-favorite;
    callback clicked();
    accessible-role: button;
    accessible-label: root.is-favorite ? @tr("Remove from favorites") : @tr("Add to favorites");
    accessible-action-default => {
        root.clicked();
    }
    width: 28px;
    height: 28px;
    border-radius: 14px;
    background: touch.has-hover ? Theme.hover : transparent;

    Icon {
        path: root.is-favorite ? Icons.heart : LibraryIcons.heart-outline;
        color: root.is-favorite ? Theme.primary : (touch.has-hover ? Theme.foreground : Theme.muted);
        width: 18px;
        height: 18px;
    }

    TooltipAnchor {
        text: root.is-favorite ? @tr("Remove from favorites") : @tr("Add to favorites");
        is-hovered: touch.has-hover;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component CardView inherits Rectangle {
    in property <Card> card;
    in property <bool> is-round;
    in property <bool> is-favorite-shown;
    callback open();
    callback toggle-favorite();
    height: self.width + 52px;

    touch := TouchArea {
        mouse-cursor: root.card.is-loaded ? pointer : default;
        clicked => {
            if (root.card.is-loaded) {
                root.open();
            }
        }
    }

    TooltipAnchor {
        text: root.card.is-loaded ? @tr("Open {}", root.card.title) : "";
        is-hovered: touch.has-hover;
    }

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.width;
        border-radius: root.is-round ? self.width / 2 : Theme.radius;
        background: Theme.surface-raised;
        clip: true;

        if root.card.has-cover: Image {
            width: parent.width;
            height: parent.height;
            source: root.card.cover;
            image-fit: cover;
        }

        if !root.card.has-cover && root.card.is-loaded: Icon {
            path: root.is-round ? Icons.artist : Icons.album;
            color: Theme.muted;
            width: parent.width * 0.35;
            height: parent.width * 0.35;
        }

        if touch.has-hover: Rectangle {
            background: Theme.tint.with-alpha(16 / 255);
        }
    }

    if root.is-favorite-shown && root.card.is-loaded && (touch.has-hover || !root.card.is-favorite): Rectangle {
        x: root.width - self.width - 8px;
        y: root.is-round ? root.width - self.height - 8px : 8px;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: #000000b0;

        FavoriteButton {
            is-favorite: root.card.is-favorite;
            clicked => {
                root.toggle-favorite();
            }
        }
    }

    if root.card.is-loaded: VerticalLayout {
        y: root.width + 8px;
        height: 44px;
        spacing: 2px;
        alignment: start;

        Text {
            text: root.card.title;
            color: Theme.foreground;
            font-weight: 600;
            overflow: elide;
            horizontal-alignment: root.is-round ? center : left;
        }

        Text {
            text: root.card.subtitle;
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
            horizontal-alignment: root.is-round ? center : left;
        }
    }

    if !root.card.is-loaded: Skeleton {
        x: 0;
        y: root.width + 12px;
        width: root.width * 0.7;
    }
}

export component CardGrid inherits Rectangle {
    in property <[CardRow]> rows;
    in property <bool> is-round;
    in property <bool> is-favorite-shown;
    in property <bool> is-loading;
    in property <string> empty-text;
    property <length> gap: 16px;
    property <length> side-padding: 20px;
    out property <int> columns: max(1, min(10, Math.floor((root.width - 2 * root.side-padding + root.gap) / (176px + root.gap))));
    property <length> card-width: (root.width - 2 * root.side-padding - (root.columns - 1) * root.gap) / root.columns;
    callback columns-changed(int);
    callback open(string);
    callback toggle-favorite(string);

    init => {
        root.columns-changed(root.columns);
    }

    changed columns => {
        root.columns-changed(root.columns);
    }

    ListView {
        for row in root.rows: HorizontalLayout {
            padding-left: root.side-padding;
            padding-right: root.side-padding;
            padding-bottom: 20px;
            spacing: root.gap;
            alignment: start;

            for card in row.cards: CardView {
                width: root.card-width;
                card: card;
                is-round: root.is-round;
                is-favorite-shown: root.is-favorite-shown;
                open => {
                    root.open(card.id);
                }
                toggle-favorite => {
                    root.toggle-favorite(card.id);
                }
            }
        }
    }

    if !root.is-loading && root.rows.length == 0: Text {
        text: root.empty-text;
        color: Theme.muted;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component TrackTable inherits Rectangle {
    in property <[TrackItem]> rows;
    in property <bool> is-loading;
    in property <bool> is-favorite-shown;
    in property <string> empty-text: @tr("No tracks found");
    callback play(int);
    callback toggle-favorite(int);
    min-width: 320px;

    VerticalLayout {
        Rectangle {
            height: 33px;
            min-width: 0px;
            clip: true;

            HorizontalLayout {
                x: list.content-x;

                HeaderCell {
                    text: "#";
                    is-sortable: false;
                    align: right;
                    column-width <=> TracksState.w-index;
                }

                HeaderCell {
                    text: @tr("Title");
                    is-sortable: false;
                    column-width <=> TracksState.w-title;
                }

                HeaderCell {
                    text: @tr("Artist");
                    is-sortable: false;
                    column-width <=> TracksState.w-artist;
                }

                HeaderCell {
                    text: @tr("Album");
                    is-sortable: false;
                    column-width <=> TracksState.w-album;
                }

                HeaderCell {
                    text: @tr("Year");
                    is-sortable: false;
                    column-width <=> TracksState.w-year;
                }

                HeaderCell {
                    text: @tr("Plays");
                    is-sortable: false;
                    column-width <=> TracksState.w-plays;
                }

                HeaderCell {
                    text: @tr("Time");
                    is-sortable: false;
                    column-width <=> TracksState.w-duration;
                }

                Rectangle { }
            }

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
        }

        Rectangle {
            min-width: 0px;
            clip: true;

            list := ListView {
                for item in root.rows: Rectangle {
                    height: 36px;

                    TrackRowView {
                        track: {
                            id: item.track.id,
                            index: item.track.index,
                            title: item.track.title,
                            artists: item.track.artists,
                            album: item.track.album,
                            duration: item.track.duration,
                            year: item.track.year,
                            plays: item.track.plays,
                            is-loaded: item.track.is-loaded,
                            is-playing: item.track.is-loaded && item.track.id == PlayerState.song-id,
                        };
                        play => {
                            root.play(item.track.index - 1);
                        }
                    }

                    if root.is-favorite-shown && item.track.is-loaded: FavoriteButton {
                        x: parent.width - self.width - 12px;
                        is-favorite: item.is-favorite;
                        clicked => {
                            root.toggle-favorite(item.track.index - 1);
                        }
                    }
                }
            }

            if !root.is-loading && root.rows.length == 0: Text {
                text: root.empty-text;
                color: Theme.muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

component GenreList inherits VerticalLayout {
    HorizontalLayout {
        padding: 20px;
        padding-bottom: 12px;
        spacing: 12px;

        Text {
            text: @tr("Genres");
            font-size: 24px;
            font-weight: 700;
            color: Theme.foreground;
            vertical-alignment: center;
        }

        Text {
            text: GenresState.is-genres-loading ? "" : GenresState.genres.length;
            color: Theme.muted;
            vertical-alignment: center;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        LineEdit {
            min-width: 140px;
            preferred-width: 280px;
            max-width: 280px;
            horizontal-stretch: 1;
            placeholder-text: @tr("Filter");
            edited(text) => {
                GenresState.filter-edited(text);
            }
        }
    }

    Rectangle {
        height: 33px;

        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;

            Text {
                text: @tr("Name");
                color: Theme.muted;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            Text {
                width: 100px;
                text: @tr("Albums");
                color: Theme.muted;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: right;
            }

            Text {
                width: 100px;
                text: @tr("Tracks");
                color: Theme.muted;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
        }

        Rectangle {
            y: parent.height - 1px;
            height: 1px;
            background: Theme.border;
        }
    }

    Rectangle {
        ListView {
            for genre in GenresState.genres: Rectangle {
                height: 40px;
                background: touch.has-hover ? Theme.hover : transparent;

                touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppState.navigate(Route.genres, genre.id);
                    }
                }

                TooltipAnchor {
                    text: @tr("Open {}", genre.name);
                    is-hovered: touch.has-hover;
                }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 20px;
                    spacing: 12px;

                    Icon {
                        y: (parent.height - self.height) / 2;
                        path: Icons.genre;
                        color: Theme.muted;
                        width: 18px;
                        height: 18px;
                    }

                    Text {
                        text: genre.name;
                        color: Theme.foreground;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }

                    Text {
                        width: 100px;
                        text: genre.albums;
                        color: Theme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }

                    Text {
                        width: 100px;
                        text: genre.tracks;
                        color: Theme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }
            }
        }

        if !GenresState.is-genres-loading && GenresState.genres.length == 0: Text {
            text: @tr("No genres found");
            color: Theme.muted;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component GenreDetail inherits VerticalLayout {
    HorizontalLayout {
        padding: 20px;
        padding-bottom: 12px;
        spacing: 12px;

        if AppState.can-go-back: IconButton {
            y: (parent.height - self.height) / 2;
            icon: LibraryIcons.arrow-back;
            tooltip: @tr("Back");
            clicked => {
                AppState.back();
            }
        }

        Text {
            text: GenresState.title;
            font-size: 24px;
            font-weight: 700;
            color: Theme.foreground;
            vertical-alignment: center;
            overflow: elide;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Tab {
            y: (parent.height - self.height) / 2;
            text: @tr("Albums");
            count: GenresState.album-count;
            is-active: GenresState.tab == GenresTab.albums;
            clicked => {
                GenresState.tab = GenresTab.albums;
            }
        }

        Tab {
            y: (parent.height - self.height) / 2;
            text: @tr("Tracks");
            count: GenresState.track-count;
            is-active: GenresState.tab == GenresTab.tracks;
            clicked => {
                GenresState.tab = GenresTab.tracks;
            }
        }
    }

    Rectangle {
        if GenresState.tab == GenresTab.albums: CardGrid {
            rows: GenresState.albums;
            is-loading: GenresState.is-albums-loading;
            empty-text: @tr("No albums found");
            columns-changed(columns) => {
                GenresState.album-columns(columns);
            }
            open(id) => {
                AppState.navigate(Route.album-detail, id);
            }
        }

        if GenresState.tab == GenresTab.tracks: TrackTable {
            rows: GenresState.tracks;
            is-loading: GenresState.is-tracks-loading;
            play(index) => {
                GenresState.play-track(index);
            }
        }
    }
}

export component GenresView inherits Rectangle {
    property <string> id: AppState.detail-id;
    min-width: 320px;
    background: Theme.background;

    init => {
        GenresState.load(root.id);
    }

    changed id => {
        if (AppState.route == Route.genres) {
            GenresState.load(root.id);
        }
    }

    if root.id == "": GenreList { }
    if root.id != "": GenreDetail { }
}
