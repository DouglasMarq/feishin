import { Button, ComboBox, LineEdit, ScrollView, Switch } from "std-widgets.slint";
import { Theme, Icons } from "theme.slint";
import { AppState, PlayerState } from "globals.slint";
import { Bar, IconButton, TooltipAnchor } from "widgets.slint";
import { AppearanceOptions } from "appearance_settings.slint";

export struct ServerRow {
    id: string,
    name: string,
    kind: string,
    detail: string,
    current: bool,
}

export struct LyricsSourceRow {
    id: string,
    name: string,
    enabled: bool,
}

export global SettingsState {
    in property <bool> loaded;
    in-out property <int> replay-gain;
    in-out property <bool> gapless: true;
    in-out property <int> crossfade-seconds;
    in property <int> max-crossfade-seconds: 12;
    in property <[string]> devices;
    in-out property <int> device-index;
    in property <[string]> bitrates;
    in-out property <int> bitrate-index;
    in property <[string]> formats;
    in-out property <int> format-index;
    in-out property <bool> scrobble: true;
    in-out property <bool> mpris: true;
    in-out property <bool> discord;
    in property <[LyricsSourceRow]> lyrics-sources;
    in property <[ServerRow]> servers;
    in property <string> switching;
    in-out property <bool> follow-current-song;
    in property <[string]> languages;
    in-out property <int> language-index;
    callback language-changed();
    callback load(string);
    callback playback-changed();
    callback integrations-changed();
    callback interface-changed();
    callback toggle-lyrics-source(int);
    callback move-lyrics-source(int, int);
    callback switch-server(string);
    callback remove-server(string);
    callback add-server();
    callback log-out();
    in-out property <string> yt-dlp-path;
    in property <[string]> cookie-browsers;
    in-out property <int> cookie-browser-index;
    in property <[string]> chart-countries;
    in-out property <int> chart-country-index;
    in-out property <string> youtube-link;
    callback youtube-changed();
    callback play-youtube-link();
    callback play-youtube-link-next();
    callback add-youtube-link();
}

component Section inherits Rectangle {
    in property <string> title;
    background: Theme.surface;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;

    VerticalLayout {
        padding: 20px;
        spacing: 18px;

        Text {
            text: root.title;
            color: Theme.foreground;
            font-size: 16px;
            font-weight: 600;
        }

        @children
    }
}

component Option inherits HorizontalLayout {
    in property <string> title;
    in property <string> description;
    spacing: 24px;

    VerticalLayout {
        alignment: center;
        spacing: 3px;
        horizontal-stretch: 1;

        Text {
            text: root.title;
            color: Theme.foreground;
        }

        if root.description != "": Text {
            text: root.description;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    VerticalLayout {
        alignment: center;
        horizontal-stretch: 0;

        HorizontalLayout {
            spacing: 8px;

            @children
        }
    }
}

component Picker inherits ComboBox {
    width: 220px;
}

component ActionChip inherits Rectangle {
    in property <string> text;
    in property <string> tooltip;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-description: root.tooltip;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    height: 32px;
    width: label.preferred-width + 24px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.4;

    label := Text {
        text: root.text;
        color: Theme.foreground;
        vertical-alignment: center;
    }

    TooltipAnchor {
        text: root.tooltip;
        hovered: touch.has-hover;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

component YouTubeSection inherits Section {
    property <bool> has-link: SettingsState.youtube-link != "";
    title: @tr("YouTube");

    Option {
        title: @tr("yt-dlp program");
        description: @tr("Plays YouTube tracks. Leave empty to use yt-dlp from your PATH.");

        path-edit := LineEdit {
            width: 220px;
            placeholder-text: "yt-dlp";
            text <=> SettingsState.yt-dlp-path;
            accepted => {
                SettingsState.youtube-changed();
            }
            changed has-focus => {
                if (!self.has-focus) {
                    SettingsState.youtube-changed();
                }
            }
        }
    }

    Option {
        title: @tr("Sign in with browser");
        description: @tr("Uses your YouTube session in this browser for a personalized Discover home and Premium audio. yt-dlp copies its cookies to a private temporary file that Feishin deletes right after reading.");

        Picker {
            model: SettingsState.cookie-browsers;
            current-index <=> SettingsState.cookie-browser-index;
            selected => {
                SettingsState.youtube-changed();
            }
        }
    }

    Option {
        title: @tr("Chart country");
        description: @tr("Default country for the Discover charts. Automatic follows your system region.");

        Picker {
            model: SettingsState.chart-countries;
            current-index <=> SettingsState.chart-country-index;
            selected => {
                SettingsState.youtube-changed();
            }
        }
    }

    Option {
        title: @tr("Play a YouTube link");
        description: @tr("Paste a YouTube or YouTube Music link to try yt-dlp.");

        LineEdit {
            width: 220px;
            placeholder-text: "https://music.youtube.com/watch?v=";
            text <=> SettingsState.youtube-link;
            accepted => {
                SettingsState.play-youtube-link();
            }
        }

        ActionChip {
            text: @tr("Play");
            enabled: root.has-link;
            tooltip: root.has-link ? @tr("Play this link now") : @tr("Paste a link first");
            clicked => {
                SettingsState.play-youtube-link();
            }
        }

        ActionChip {
            text: @tr("Play next");
            enabled: root.has-link;
            tooltip: root.has-link ? @tr("Play this link after the current song") : @tr("Paste a link first");
            clicked => {
                SettingsState.play-youtube-link-next();
            }
        }

        ActionChip {
            text: @tr("Add to queue");
            enabled: root.has-link;
            tooltip: root.has-link ? @tr("Add this link to the end of the queue") : @tr("Paste a link first");
            clicked => {
                SettingsState.add-youtube-link();
            }
        }
    }
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

component LyricsSourceItem inherits Rectangle {
    in property <LyricsSourceRow> source;
    in property <int> index;
    in property <int> count;
    height: 40px;
    border-radius: Theme.radius;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea { }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 4px;
        spacing: 8px;

        Text {
            text: (root.index + 1) + ".";
            width: 20px;
            color: Theme.muted;
            vertical-alignment: center;
        }

        Text {
            text: root.source.name;
            color: root.source.enabled ? Theme.foreground : Theme.muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.arrow-up;
            tooltip: @tr("Move up");
            enabled: root.index > 0;
            clicked => {
                SettingsState.move-lyrics-source(root.index, -1);
            }
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.arrow-down;
            tooltip: @tr("Move down");
            enabled: root.index < root.count - 1;
            clicked => {
                SettingsState.move-lyrics-source(root.index, 1);
            }
        }

        Switch {
            checked: root.source.enabled;
            toggled => {
                SettingsState.toggle-lyrics-source(root.index);
            }
        }
    }
}

component ServerItem inherits Rectangle {
    in property <ServerRow> server;
    in-out property <string> confirming;
    property <bool> confirm: root.confirming == root.server.id;
    property <bool> busy: SettingsState.switching != "";
    min-height: 56px;
    border-radius: Theme.radius;
    background: root.server.current ? Theme.selected : (touch.has-hover ? Theme.hover : transparent);

    touch := TouchArea { }

    HorizontalLayout {
        padding: 10px;
        padding-left: 14px;
        spacing: 10px;

        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;

            HorizontalLayout {
                spacing: 8px;
                alignment: start;

                Text {
                    text: root.server.name;
                    color: Theme.foreground;
                    font-weight: 600;
                    overflow: elide;
                }

                Rectangle {
                    width: kind-text.preferred-width + 12px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.surface-raised;

                    kind-text := Text {
                        text: root.server.kind;
                        color: Theme.muted;
                        font-size: 11px;
                    }
                }

                if root.server.current: Rectangle {
                    width: current-text.preferred-width + 12px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.primary;

                    current-text := Text {
                        text: @tr("Current");
                        color: Theme.on-primary;
                        font-size: 11px;
                        font-weight: 600;
                    }
                }
            }

            Text {
                text: root.server.detail;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }

        if !root.server.current && !root.confirm: Button {
            text: SettingsState.switching == root.server.id ? @tr("Connecting...") : @tr("Switch");
            enabled: !root.busy;
            clicked => {
                SettingsState.switch-server(root.server.id);
            }
        }

        if !root.confirm: Button {
            text: @tr("Remove");
            enabled: !root.busy;
            clicked => {
                root.confirming = root.server.id;
            }
        }

        if root.confirm: Text {
            text: root.server.current ? @tr("Sign out and forget this server?") : @tr("Forget this server?");
            color: Theme.danger;
            vertical-alignment: center;
        }

        if root.confirm: Button {
            text: @tr("Cancel");
            clicked => {
                root.confirming = "";
            }
        }

        if root.confirm: Button {
            text: @tr("Remove");
            primary: true;
            clicked => {
                root.confirming = "";
                SettingsState.remove-server(root.server.id);
            }
        }
    }
}

export component SettingsView inherits Rectangle {
    property <string> confirming;
    property <bool> confirm-logout;
    background: Theme.background;

    init => {
        SettingsState.load(AppState.detail-id);
    }

    scroll := ScrollView {
        VerticalLayout {
            width: scroll.visible-width;
            padding: 28px;
            padding-top: 24px;
            spacing: 20px;
            alignment: start;

            Text {
                text: @tr("Settings");
                color: Theme.foreground;
                font-size: 24px;
                font-weight: 700;
            }

            Section {
                title: @tr("Playback");

                Option {
                    title: @tr("Volume");
                    description: @tr("Starting volume, shared with the player bar.");

                    VerticalLayout {
                        alignment: center;

                        volume-bar := Bar {
                            width: 160px;
                            value: PlayerState.volume / 100;
                            scroll-step: 0.05;
                            tooltip: @tr("Volume {}%", self.adjusting ? Math.round(self.drag-preview * 100) : PlayerState.volume);
                            changed(value) => {
                                PlayerState.set-volume(Math.round(value * 100));
                            }
                        }
                    }

                    Text {
                        text: (volume-bar.adjusting ? Math.round(volume-bar.drag-preview * 100) : PlayerState.volume) + "%";
                        width: 40px;
                        color: Theme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }

                Option {
                    title: @tr("ReplayGain");
                    description: @tr("Normalize loudness using the track or album gain tags.");

                    Picker {
                        model: [@tr("Off"), @tr("Track"), @tr("Album")];
                        current-index <=> SettingsState.replay-gain;
                        selected => {
                            SettingsState.playback-changed();
                        }
                    }
                }

                Option {
                    title: @tr("Gapless playback");
                    description: @tr("Preload the next song so it starts without a pause.");

                    Switch {
                        checked <=> SettingsState.gapless;
                        toggled => {
                            SettingsState.playback-changed();
                        }
                    }
                }

                crossfade-option := Option {
                    title: @tr("Crossfade");
                    description: @tr("Fade the end of each song into the next one. Off keeps gapless playback.");
                    property <int> shown-seconds: crossfade-bar.adjusting ? Math.round(crossfade-bar.drag-preview * SettingsState.max-crossfade-seconds) : SettingsState.crossfade-seconds;
                    property <string> shown-label: self.shown-seconds == 0 ? @tr("Off") : @tr("{} s", self.shown-seconds);

                    VerticalLayout {
                        alignment: center;

                        crossfade-bar := Bar {
                            width: 160px;
                            value: SettingsState.crossfade-seconds / SettingsState.max-crossfade-seconds;
                            scroll-step: 1 / SettingsState.max-crossfade-seconds;
                            tooltip: @tr("Crossfade: {}", crossfade-option.shown-label);
                            committed(value) => {
                                SettingsState.crossfade-seconds = Math.round(value * SettingsState.max-crossfade-seconds);
                                SettingsState.playback-changed();
                            }
                        }
                    }

                    Text {
                        text: crossfade-option.shown-label;
                        width: 40px;
                        color: Theme.muted;
                        vertical-alignment: center;
                        horizontal-alignment: right;
                    }
                }

                Option {
                    title: @tr("Audio device");
                    description: @tr("Output used by the player.");

                    Picker {
                        model: SettingsState.devices;
                        current-index <=> SettingsState.device-index;
                        selected => {
                            SettingsState.playback-changed();
                        }
                    }
                }

                Option {
                    title: @tr("Maximum bitrate");
                    description: @tr("Ask the server to transcode down to this bitrate. Applies from the next song.");

                    Picker {
                        model: SettingsState.bitrates;
                        current-index <=> SettingsState.bitrate-index;
                        selected => {
                            SettingsState.playback-changed();
                        }
                    }
                }

                Option {
                    title: @tr("Transcode format");
                    description: @tr("Format the server should transcode to. Applies from the next song.");

                    Picker {
                        model: SettingsState.formats;
                        current-index <=> SettingsState.format-index;
                        selected => {
                            SettingsState.playback-changed();
                        }
                    }
                }

                Option {
                    title: @tr("Scrobble");
                    description: @tr("Report what you play to the server.");

                    Switch {
                        checked <=> SettingsState.scrobble;
                        toggled => {
                            SettingsState.playback-changed();
                        }
                    }
                }
            }

            Section {
                title: @tr("Integrations");

                Option {
                    title: @tr("MPRIS");
                    description: @tr("Media keys and desktop media controls. Takes effect after a restart.");

                    Switch {
                        checked <=> SettingsState.mpris;
                        toggled => {
                            SettingsState.integrations-changed();
                        }
                    }
                }

                Option {
                    title: @tr("Discord Rich Presence");
                    description: @tr("Show the current song on your Discord profile.");

                    Switch {
                        checked <=> SettingsState.discord;
                        toggled => {
                            SettingsState.integrations-changed();
                        }
                    }
                }

                Divider { }

                VerticalLayout {
                    spacing: 6px;

                    Text {
                        text: @tr("Lyrics sources");
                        color: Theme.foreground;
                    }

                    Text {
                        text: @tr("Searched from top to bottom until one has lyrics.");
                        color: Theme.muted;
                        font-size: 12px;
                    }

                    VerticalLayout {
                        padding-top: 4px;
                        spacing: 2px;

                        for row[index] in SettingsState.lyrics-sources: LyricsSourceItem {
                            source: row;
                            index: index;
                            count: SettingsState.lyrics-sources.length;
                        }
                    }
                }
            }

            YouTubeSection { }

            Section {
                title: @tr("Servers");

                VerticalLayout {
                    spacing: 4px;

                    for row in SettingsState.servers: ServerItem {
                        server: row;
                        confirming <=> root.confirming;
                    }

                    if SettingsState.loaded && SettingsState.servers.length == 0: Text {
                        text: @tr("No saved servers.");
                        color: Theme.muted;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Button {
                        text: @tr("Add server");
                        enabled: SettingsState.switching == "";
                        clicked => {
                            SettingsState.add-server();
                        }
                    }

                    if !root.confirm-logout: Button {
                        text: @tr("Log out");
                        enabled: SettingsState.switching == "" && AppState.server-name != "";
                        clicked => {
                            root.confirm-logout = true;
                        }
                    }

                    if root.confirm-logout: Text {
                        text: @tr("Sign out and forget this server's saved login?");
                        color: Theme.danger;
                        vertical-alignment: center;
                    }

                    if root.confirm-logout: Button {
                        text: @tr("Cancel");
                        clicked => {
                            root.confirm-logout = false;
                        }
                    }

                    if root.confirm-logout: Button {
                        text: @tr("Log out");
                        primary: true;
                        clicked => {
                            root.confirm-logout = false;
                            SettingsState.log-out();
                        }
                    }
                }
            }

            Section {
                title: @tr("Appearance");

                AppearanceOptions { }
            }

            Section {
                title: @tr("Interface");

                Option {
                    title: @tr("Language");
                    description: @tr("System default follows the language of the desktop.");

                    Picker {
                        model: SettingsState.languages;
                        current-index <=> SettingsState.language-index;
                        selected => {
                            SettingsState.language-changed();
                        }
                    }
                }

                Option {
                    title: @tr("Open the queue panel");
                    description: @tr("Show the queue next to the library; remembered on the next start.");

                    Switch {
                        checked <=> AppState.queue-open;
                        toggled => {
                            SettingsState.interface-changed();
                        }
                    }
                }

                Option {
                    title: @tr("Follow current song");
                    description: @tr("Scroll lists and the queue to the song that is playing.");

                    Switch {
                        checked <=> SettingsState.follow-current-song;
                        toggled => {
                            SettingsState.interface-changed();
                        }
                    }
                }
            }
        }
    }
}
