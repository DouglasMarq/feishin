import { Button, ListView, Switch } from "std-widgets.slint";
import { Behaviour, Icons, Motion, Theme } from "theme.slint";

export global Tooltip {
    out property <string> text;
    out property <length> anchor-x;
    out property <length> anchor-y;
    out property <length> anchor-width;
    out property <length> anchor-height;
    out property <bool> is-visible;
    property <int> serial;

    public function show(text: string, left: length, top: length, width: length, height: length) -> int {
        self.serial += 1;
        self.text = text;
        self.anchor-x = left;
        self.anchor-y = top;
        self.anchor-width = width;
        self.anchor-height = height;
        self.is-visible = text != "";
        self.serial
    }

    public function update(token: int, text: string, left: length, width: length) {
        if (token == self.serial && self.is-visible) {
            self.text = text;
            self.anchor-x = left;
            self.anchor-width = width;
        }
    }

    public function hide(token: int) {
        if (token == self.serial) {
            self.is-visible = false;
        }
    }
}

export component AmbientBackdrop inherits Rectangle {
    in property <color> tint;
    in property <bool> has-tint;
    property <color> base: root.has-tint ? Theme.ambient(root.tint) : Theme.surface-raised.mix(Theme.panel, 0.6);
    background: @linear-gradient(180deg, root.base 0%, root.base.mix(Theme.panel, 0.55) 45%, Theme.panel 100%);

    animate base {
        duration: Motion.ambient;
        easing: ease-in-out;
    }
}

export component PageFade inherits Rectangle {
    opacity: 0;

    init => {
        self.opacity = 1;
    }

    animate opacity {
        duration: Motion.page;
        easing: ease-out;
    }

    @children
}

export component TooltipOverlay inherits Rectangle {
    property <length> gap: 6px;
    property <length> above-y: Tooltip.anchor-y - bubble.height - root.gap;

    bubble := Rectangle {
        opacity: Tooltip.is-visible ? 1 : 0;

        animate opacity {
            duration: Motion.quick;
        }

        width: label.preferred-width + 16px;
        height: label.preferred-height + 10px;
        x: max(4px, min(root.width - self.width - 4px, Tooltip.anchor-x + Tooltip.anchor-width / 2 - self.width / 2));
        y: root.above-y >= 4px ? root.above-y : Tooltip.anchor-y + Tooltip.anchor-height + root.gap;
        border-radius: 4px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border;

        label := Text {
            text: Tooltip.text;
            color: Theme.foreground;
            font-size: 12px;
        }
    }
}

export component TooltipAnchor {
    in property <string> text;
    in property <bool> is-hovered;
    in property <bool> is-active;
    in property <length> follow-x: -1px;
    property <int> token: -1;
    property <bool> is-shown;
    property <bool> is-wanted: (root.is-hovered || root.is-active) && root.text != "";
    property <length> tip-x: root.follow-x >= 0 ? root.absolute-position.x + root.follow-x : root.absolute-position.x;
    property <length> tip-width: root.follow-x >= 0 ? 0px : root.width;
    width: 100%;
    height: 100%;

    function open() {
        root.token = Tooltip.show(root.text, root.tip-x, root.absolute-position.y, root.tip-width, root.height);
        root.is-shown = true;
    }

    Timer {
        interval: Behaviour.tooltip-delay;
        running: root.is-wanted && !root.is-shown && !root.is-active;
        triggered => {
            root.open();
        }
    }

    changed is-active => {
        if (root.is-active && root.text != "" && !root.is-shown) {
            root.open();
        }
    }

    changed is-wanted => {
        if (!root.is-wanted && root.is-shown) {
            Tooltip.hide(root.token);
            root.is-shown = false;
        }
    }

    changed text => {
        if (root.is-shown) {
            Tooltip.update(root.token, root.text, root.tip-x, root.tip-width);
        }
    }

    changed tip-x => {
        if (root.is-shown) {
            Tooltip.update(root.token, root.text, root.tip-x, root.tip-width);
        }
    }
}

export component TooltipButton inherits Rectangle {
    in property <string> text;
    in property <string> tooltip;
    in property <bool> is-primary;
    in property <bool> is-enabled: true;
    callback clicked();
    min-width: button.min-width;
    min-height: button.min-height;
    preferred-width: button.preferred-width;
    preferred-height: button.preferred-height;
    horizontal-stretch: 0;
    vertical-stretch: 0;

    hover := TouchArea {
        button := Button {
            width: parent.width;
            height: parent.height;
            text: root.text;
            primary: root.is-primary;
            enabled: root.is-enabled;
            accessible-description: root.tooltip;
            clicked => {
                root.clicked();
            }
        }
    }

    TooltipAnchor {
        text: root.tooltip;
        is-hovered: hover.has-hover;
    }
}

export component TooltipSwitch inherits Rectangle {
    in property <string> label;
    in-out property <bool> is-checked;
    callback toggled();
    width: toggle.preferred-width;
    height: toggle.preferred-height;

    hover := TouchArea {
        toggle := Switch {
            checked <=> root.is-checked;
            accessible-label: root.label;
            toggled => {
                root.toggled();
            }
        }
    }

    TooltipAnchor {
        text: root.is-checked ? @tr("{}: on", root.label) : @tr("{}: off", root.label);
        is-hovered: hover.has-hover;
    }
}

export component Icon inherits Path {
    in property <string> path;
    in property <color> color: Theme.foreground;
    property <bool> is-outlined: Icons.is-outlined(root.path);
    commands: root.path;
    fill: root.is-outlined ? transparent : root.color;
    stroke: root.is-outlined ? root.color : transparent;
    stroke-width: root.is-outlined ? 2px * root.width / 24px : 0px;
    stroke-line-cap: round;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 20px;
    height: 20px;
}

export component TooltipComboBox inherits Rectangle {
    in property <string> tooltip;
    in property <[string]> model;
    in property <bool> is-enabled: true;
    in-out property <int> current-index;
    out property <string> current-value: root.model[root.current-index];
    callback selected(current-value: string);
    property <length> item-height: 30px;
    property <int> max-visible-items: 10;
    property <int> first-visible-index: max(0, min(root.current-index - 4, root.model.length - root.max-visible-items));
    min-width: 60px;
    min-height: 30px;
    max-height: 30px;
    preferred-width: 160px;
    preferred-height: 30px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: keys.has-focus ? Theme.primary : Theme.border;
    background: touch.has-hover && root.is-enabled ? Theme.hover : transparent;
    opacity: root.is-enabled ? 1 : 0.5;
    accessible-role: combobox;
    accessible-value: root.current-value;
    accessible-description: root.tooltip;

    function pick(index: int) {
        if (index < 0 || index >= root.model.length || index == root.current-index) {
            return;
        }
        root.current-index = index;
        root.selected(root.current-value);
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 4px;

        Text {
            text: root.current-value;
            color: Theme.foreground;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }

        Icon {
            y: (parent.height - self.height) / 2;
            path: Icons.arrow-down;
            color: Theme.muted;
            width: 18px;
            height: 18px;
        }
    }

    TooltipAnchor {
        text: root.tooltip;
        is-hovered: touch.has-hover;
    }

    keys := FocusScope {
        enabled: root.is-enabled;
        key-pressed(event) => {
            if (event.text == Key.UpArrow) {
                root.pick(root.current-index - 1);
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.pick(root.current-index + 1);
                return accept;
            }
            if (event.text == Key.Return || event.text == " ") {
                menu.show();
                return accept;
            }
            return reject;
        }
    }

    touch := TouchArea {
        enabled: root.is-enabled;
        mouse-cursor: pointer;
        clicked => {
            keys.focus();
            menu.show();
        }
    }

    menu := PopupWindow {
        y: root.height + 4px;
        width: max(root.width, 140px);
        height: min(root.model.length, root.max-visible-items) * root.item-height + 8px;

        Rectangle {
            background: Theme.surface-raised;
            border-radius: Theme.radius-card;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 12px;
            drop-shadow-color: Theme.shadow;
        }

        options := ListView {
            x: 4px;
            y: 4px;
            width: parent.width - 8px;
            height: parent.height - 8px;
            init => {
                self.content-y = -root.first-visible-index * root.item-height;
            }

            for item[index] in root.model: option := Rectangle {
                height: root.item-height;
                border-radius: Theme.radius;
                background: index == root.current-index ? Theme.selected : option-touch.has-hover ? Theme.hover : transparent;

                Text {
                    x: 10px;
                    width: parent.width - 20px;
                    text: item;
                    color: Theme.foreground;
                    vertical-alignment: center;
                    overflow: elide;
                }

                option-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.pick(index);
                        menu.close();
                    }
                }
            }
        }
    }
}

export component SearchField inherits Rectangle {
    in property <string> placeholder-text;
    in-out property <string> text <=> input.text;
    callback edited(text: string);
    callback accepted(text: string);
    min-width: 80px;
    min-height: 32px;
    max-height: 32px;
    preferred-width: 280px;
    preferred-height: 32px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: self.height / 2;
    border-width: 1px;
    border-color: input.has-focus ? Theme.primary : Theme.border;
    background: input.has-focus || hover.has-hover ? Theme.hover : transparent;
    forward-focus: input;

    hover := TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => {
            input.focus();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 8px;

        Icon {
            y: (parent.height - self.height) / 2;
            path: Icons.search;
            color: input.has-focus ? Theme.foreground : Theme.muted;
            width: 16px;
            height: 16px;
        }

        Rectangle {
            horizontal-stretch: 1;

            if root.text == "": Text {
                width: 100%;
                height: 100%;
                text: root.placeholder-text;
                color: Theme.muted;
                vertical-alignment: center;
                overflow: elide;
            }

            input := TextInput {
                width: 100%;
                height: 100%;
                color: Theme.foreground;
                selection-background-color: Theme.primary.with-alpha(0.35);
                selection-foreground-color: Theme.foreground;
                vertical-alignment: center;
                single-line: true;
                accessible-placeholder-text: root.placeholder-text;
                edited => {
                    root.edited(self.text);
                }
                accepted => {
                    root.accepted(self.text);
                }
            }
        }

        if root.text != "": clear := Rectangle {
            y: (parent.height - self.height) / 2;
            width: 20px;
            height: 20px;
            border-radius: 10px;
            background: clear-touch.has-hover ? Theme.hover : transparent;

            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                path: Icons.close;
                color: Theme.muted;
                width: 14px;
                height: 14px;
            }

            TooltipAnchor {
                text: @tr("Clear search");
                is-hovered: clear-touch.has-hover;
            }

            clear-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    input.text = "";
                    root.edited("");
                    input.focus();
                }
            }
        }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> is-active;
    in property <bool> is-enabled: true;
    in property <length> icon-size: 20px;
    in property <color> icon-color: root.is-active ? Theme.primary : (touch.has-hover && root.is-enabled ? Theme.foreground : Theme.muted);
    callback clicked();
    accessible-role: button;
    accessible-label: root.tooltip;
    accessible-enabled: root.is-enabled;
    accessible-action-default => {
        if (root.is-enabled) {
            root.clicked();
        }
    }
    width: 32px;
    height: 32px;
    border-radius: self.height / 2;
    background: touch.has-hover && root.is-enabled ? Theme.hover : transparent;
    opacity: root.is-enabled ? 1 : 0.4;

    animate background {
        duration: Motion.quick;
    }

    Icon {
        path: root.icon;
        color: root.icon-color;
        width: root.icon-size;
        height: root.icon-size;
        transform-scale: touch.pressed && root.is-enabled ? 0.88 : 1;

        animate transform-scale {
            duration: Motion.quick;
            easing: ease-out;
        }
    }

    TooltipAnchor {
        text: root.tooltip;
        is-hovered: touch.has-hover;
    }

    touch := TouchArea {
        mouse-cursor: root.is-enabled ? pointer : default;
        clicked => {
            if (root.is-enabled) {
                root.clicked();
            }
        }
    }
}

export component Bar inherits Rectangle {
    in property <float> value;
    in property <float> scroll-step;
    in property <string> tooltip;
    in property <bool> is-tooltip-following-pointer;
    in property <bool> is-enabled: true;
    out property <bool> is-dragging: touch.pressed && root.is-enabled;
    out property <float> hover-value: max(0, min(1, touch.mouse-x / root.width));
    out property <float> drag-preview: root.drag-value;
    out property <bool> is-adjusting: root.is-dragging || root.is-scrolling;
    out property <bool> is-holding: root.is-dragging || root.is-settling;
    property <bool> is-scrolling;
    property <float> drag-value;
    property <bool> is-settling;
    property <float> shown: root.is-dragging || root.is-settling ? root.drag-value : root.value;
    callback changed(value: float);
    callback committed(value: float);
    accessible-role: slider;
    accessible-label: root.tooltip;
    accessible-enabled: root.is-enabled;
    accessible-value: Math.round(root.value * 100) + "%";
    accessible-value-minimum: 0;
    accessible-value-maximum: 1;
    accessible-value-step: root.scroll-step;
    accessible-action-increment => {
        root.step-by(root.scroll-step);
    }
    accessible-action-decrement => {
        root.step-by(-root.scroll-step);
    }
    height: 16px;


    function step-by(delta: float) {
        if (root.is-enabled) {
            root.changed(max(0, min(1, root.value + delta)));
            root.committed(max(0, min(1, root.value + delta)));
        }
    }

    property <bool> is-engaged: (touch.has-hover && root.is-enabled) || root.is-dragging;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: root.is-engaged ? 6px : 4px;
        border-radius: self.height / 2;
        background: Theme.foreground.with-alpha(0.16);

        animate height {
            duration: Motion.quick;
            easing: ease-out;
        }

        Rectangle {
            x: 0;
            width: parent.width * max(0, min(1, root.shown));
            border-radius: parent.border-radius;
            background: root.is-engaged ? Theme.primary : Theme.foreground.with-alpha(0.85);

            animate background {
                duration: Motion.quick;
            }
        }
    }

    Rectangle {
        x: root.width * max(0, min(1, root.shown)) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.foreground;
        opacity: root.is-engaged ? 1 : 0;
        transform-scale: root.is-engaged ? 1 : 0.4;
        drop-shadow-blur: 4px;
        drop-shadow-color: #00000066;

        animate opacity, transform-scale {
            duration: Motion.quick;
            easing: ease-out;
        }
    }

    TooltipAnchor {
        text: root.tooltip;
        is-hovered: touch.has-hover;
        is-active: root.is-dragging || root.is-scrolling;
        follow-x: root.is-tooltip-following-pointer ? (root.is-dragging ? root.width * root.drag-value : touch.mouse-x) : -1px;
    }

    settle-timer := Timer {
        interval: Behaviour.bar-settle-timeout;
        running: root.is-settling;
        triggered => {
            root.is-settling = false;
        }
    }

    changed value => {
        if (root.is-settling && abs(root.value - root.drag-value) < 0.01) {
            root.is-settling = false;
        }
    }

    scroll-timer := Timer {
        interval: Behaviour.bar-scroll-timeout;
        running: root.is-scrolling;
        triggered => {
            root.is-scrolling = false;
        }
    }

    touch := TouchArea {
        mouse-cursor: root.is-enabled ? pointer : default;
        scroll-event(event) => {
            if (!root.is-enabled || root.scroll-step <= 0 || event.delta-y == 0) {
                return reject;
            }
            root.drag-value = max(0, min(1, root.value + (event.delta-y > 0 ? root.scroll-step : -root.scroll-step)));
            root.changed(root.drag-value);
            root.is-settling = true;
            settle-timer.restart();
            root.committed(root.drag-value);
            root.is-scrolling = true;
            scroll-timer.restart();
            accept
        }
        pointer-event(event) => {
            if (!root.is-enabled) {
                return;
            }
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.drag-value = max(0, min(1, self.mouse-x / root.width));
                root.changed(root.drag-value);
            } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.is-settling = true;
                settle-timer.restart();
                root.committed(root.drag-value);
            }
        }
        moved => {
            if (self.pressed && root.is-enabled) {
                root.drag-value = max(0, min(1, self.mouse-x / root.width));
                root.changed(root.drag-value);
            }
        }
    }
}
