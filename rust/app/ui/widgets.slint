import { Theme } from "theme.slint";

export global Tooltip {
    out property <string> text;
    out property <length> anchor-x;
    out property <length> anchor-y;
    out property <length> anchor-width;
    out property <length> anchor-height;
    out property <bool> visible;
    property <int> serial;

    public function show(text: string, left: length, top: length, width: length, height: length) -> int {
        self.serial += 1;
        self.text = text;
        self.anchor-x = left;
        self.anchor-y = top;
        self.anchor-width = width;
        self.anchor-height = height;
        self.visible = text != "";
        self.serial
    }

    public function update(token: int, text: string, left: length, width: length) {
        if (token == self.serial && self.visible) {
            self.text = text;
            self.anchor-x = left;
            self.anchor-width = width;
        }
    }

    public function hide(token: int) {
        if (token == self.serial) {
            self.visible = false;
        }
    }
}

export component TooltipOverlay inherits Rectangle {
    property <length> gap: 6px;
    property <length> above-y: Tooltip.anchor-y - bubble.height - root.gap;

    bubble := Rectangle {
        visible: Tooltip.visible;
        width: label.preferred-width + 16px;
        height: label.preferred-height + 10px;
        x: max(4px, min(root.width - self.width - 4px, Tooltip.anchor-x + Tooltip.anchor-width / 2 - self.width / 2));
        y: root.above-y >= 4px ? root.above-y : Tooltip.anchor-y + Tooltip.anchor-height + root.gap;
        border-radius: 4px;
        background: Theme.surface-raised;
        border-width: 1px;
        border-color: Theme.border;

        label := Text {
            text: Tooltip.text;
            color: Theme.foreground;
            font-size: 12px;
        }
    }
}

export component TooltipAnchor {
    in property <string> text;
    in property <bool> hovered;
    in property <bool> active;
    in property <length> follow-x: -1px;
    property <int> token: -1;
    property <bool> shown;
    property <bool> wanted: (root.hovered || root.active) && root.text != "";
    property <length> tip-x: root.follow-x >= 0 ? root.absolute-position.x + root.follow-x : root.absolute-position.x;
    property <length> tip-width: root.follow-x >= 0 ? 0px : root.width;
    width: 100%;
    height: 100%;

    function open() {
        root.token = Tooltip.show(root.text, root.tip-x, root.absolute-position.y, root.tip-width, root.height);
        root.shown = true;
    }

    Timer {
        interval: 450ms;
        running: root.wanted && !root.shown && !root.active;
        triggered => {
            root.open();
        }
    }

    changed active => {
        if (root.active && root.text != "" && !root.shown) {
            root.open();
        }
    }

    changed wanted => {
        if (!root.wanted && root.shown) {
            Tooltip.hide(root.token);
            root.shown = false;
        }
    }

    changed text => {
        if (root.shown) {
            Tooltip.update(root.token, root.text, root.tip-x, root.tip-width);
        }
    }

    changed tip-x => {
        if (root.shown) {
            Tooltip.update(root.token, root.text, root.tip-x, root.tip-width);
        }
    }
}

export component Icon inherits Path {
    in property <string> path;
    in property <color> color: Theme.foreground;
    commands: root.path;
    fill: root.color;
    viewbox-width: 24;
    viewbox-height: 24;
    width: 20px;
    height: 20px;
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> tooltip;
    in property <bool> active;
    in property <bool> enabled: true;
    in property <length> icon-size: 20px;
    in property <color> icon-color: root.active ? Theme.primary : (touch.has-hover ? Theme.foreground : Theme.muted);
    callback clicked();
    width: 32px;
    height: 32px;
    border-radius: self.height / 2;
    background: touch.has-hover && root.enabled ? Theme.hover : transparent;
    opacity: root.enabled ? 1 : 0.4;

    Icon {
        path: root.icon;
        color: root.icon-color;
        width: root.icon-size;
        height: root.icon-size;
    }

    TooltipAnchor {
        text: root.tooltip;
        hovered: touch.has-hover;
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component Bar inherits Rectangle {
    in property <float> value;
    in property <float> scroll-step;
    in property <string> tooltip;
    in property <bool> tooltip-follows-pointer;
    out property <bool> dragging: touch.pressed;
    out property <float> hover-value: max(0, min(1, touch.mouse-x / root.width));
    out property <float> drag-preview: root.drag-value;
    out property <bool> adjusting: root.dragging || root.scrolling;
    out property <bool> holding: root.dragging || root.settling;
    property <bool> scrolling;
    property <float> drag-value;
    property <bool> settling;
    property <float> shown: root.dragging || root.settling ? root.drag-value : root.value;
    callback changed(value: float);
    callback committed(value: float);
    height: 16px;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: Theme.surface-raised;

        Rectangle {
            x: 0;
            width: parent.width * max(0, min(1, root.shown));
            border-radius: 2px;
            background: touch.has-hover || root.dragging ? Theme.primary : Theme.foreground;
        }
    }

    if touch.has-hover || root.dragging: Rectangle {
        x: root.width * max(0, min(1, root.shown)) - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.foreground;
    }

    TooltipAnchor {
        text: root.tooltip;
        hovered: touch.has-hover;
        active: root.dragging || root.scrolling;
        follow-x: root.tooltip-follows-pointer ? (root.dragging ? root.width * root.drag-value : touch.mouse-x) : -1px;
    }

    settle-timer := Timer {
        interval: 1500ms;
        running: root.settling;
        triggered => {
            root.settling = false;
        }
    }

    changed value => {
        if (root.settling && abs(root.value - root.drag-value) < 0.01) {
            root.settling = false;
        }
    }

    scroll-timer := Timer {
        interval: 800ms;
        running: root.scrolling;
        triggered => {
            root.scrolling = false;
        }
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        scroll-event(event) => {
            if (root.scroll-step <= 0 || event.delta-y == 0) {
                return reject;
            }
            root.drag-value = max(0, min(1, root.value + (event.delta-y > 0 ? root.scroll-step : -root.scroll-step)));
            root.changed(root.drag-value);
            root.settling = true;
            settle-timer.restart();
            root.committed(root.drag-value);
            root.scrolling = true;
            scroll-timer.restart();
            accept
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                root.drag-value = max(0, min(1, self.mouse-x / root.width));
                root.changed(root.drag-value);
            } else if (event.kind == PointerEventKind.up && event.button == PointerEventButton.left) {
                root.settling = true;
                settle-timer.restart();
                root.committed(root.drag-value);
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-value = max(0, min(1, self.mouse-x / root.width));
                root.changed(root.drag-value);
            }
        }
    }
}
