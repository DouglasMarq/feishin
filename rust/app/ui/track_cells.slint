import { Theme, Icons } from "theme.slint";
import { TrackColumn, TracksState } from "globals.slint";
import { Icon, TooltipAnchor } from "widgets.slint";

global Glyphs {
    out property <string> star: "M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z";
    out property <string> heart-outline: "M16.5 3c-1.74 0-3.41.81-4.5 2.09C10.91 3.81 9.24 3 7.5 3 4.42 3 2 5.42 2 8.5c0 3.78 3.4 6.86 8.55 11.54L12 21.35l1.45-1.32C18.6 15.36 22 12.28 22 8.5 22 5.42 19.58 3 16.5 3zm-4.4 15.55l-.1.1-.1-.1C7.14 14.24 4 11.39 4 8.5 4 6.5 5.5 5 7.5 5c1.54 0 3.04.99 3.57 2.36h1.87C13.46 5.99 14.96 5 16.5 5c2 0 3.5 1.5 3.5 3.5 0 2.89-3.14 5.74-7.9 10.05z";
}

export component HeaderCell inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <TrackColumn> column;
    in property <bool> is-sortable: true;
    in property <TextHorizontalAlignment> align: left;
    in-out property <length> column-width;
    callback resized(width: length);
    property <bool> is-sorted: root.is-sortable && TracksState.sort-column == root.column;
    callback context-menu(window-x: length, window-y: length);
    width: root.column-width;
    height: 32px;

    resized(width) => {
        root.column-width = width;
    }

    TooltipAnchor {
        text: !root.is-sortable ? "" : !root.is-sorted ? @tr("Sort by {}", root.text) : TracksState.is-sort-descending ? @tr("Sort by {}: descending", root.text) : @tr("Sort by {}: ascending", root.text);
        is-hovered: sort-touch.has-hover;
    }

    sort-touch := TouchArea {
        mouse-cursor: root.is-sortable ? pointer : default;
        clicked => {
            if (root.is-sortable) {
                TracksState.sort-by(root.column);
            }
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 2px;

        if root.icon == "": Text {
            text: root.text;
            color: root.is-sorted ? Theme.foreground : Theme.muted;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: root.align;
            overflow: elide;
            horizontal-stretch: 1;
        }

        if root.icon != "": Rectangle {
            horizontal-stretch: 1;

            Icon {
                x: 0;
                path: root.icon;
                color: root.is-sorted ? Theme.foreground : Theme.muted;
                width: 14px;
                height: 14px;
            }
        }

        if root.is-sorted: Icon {
            y: (parent.height - self.height) / 2;
            path: TracksState.is-sort-descending ? Icons.arrow-down : Icons.arrow-up;
            color: Theme.foreground;
            width: 16px;
            height: 16px;
        }
    }

    resize-touch := TouchArea {
        x: parent.width - 5px;
        width: 8px;
        mouse-cursor: col-resize;

        TooltipAnchor {
            text: @tr("Resize column");
            is-hovered: resize-touch.has-hover;
        }

        moved => {
            if (self.pressed) {
                root.resized(max(40px, root.column-width + self.mouse-x - self.pressed-x));
            }
        }
    }
}

export component Cell inherits Rectangle {
    in property <string> text;
    in property <color> text-color: Theme.muted;

    Text {
        x: 8px;
        width: parent.width - 18px;
        text: root.text;
        color: root.text-color;
        vertical-alignment: center;
        overflow: elide;
    }
}

export component LinkCell inherits Rectangle {
    in property <string> text;
    in property <bool> is-enabled: true;
    callback clicked();
    callback context-menu(window-x: length, window-y: length);

    label := Text {
        x: 8px;
        width: parent.width - 18px;
        text: root.text;
        color: link.has-hover && root.is-enabled ? Theme.foreground : Theme.muted;
        vertical-alignment: center;
        overflow: elide;
    }

    link := TouchArea {
        x: 8px;
        width: min(label.preferred-width, parent.width - 18px);
        enabled: root.is-enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }

        TooltipAnchor {
            text: root.is-enabled ? @tr("Go to {}", root.text) : "";
            is-hovered: link.has-hover;
        }
    }
}

export component FavoriteCell inherits Rectangle {
    in property <bool> is-favorite;
    in property <bool> is-row-hovered;
    callback toggle();
    callback context-menu(window-x: length, window-y: length);

    if root.is-favorite || root.is-row-hovered: Icon {
        x: 8px;
        path: root.is-favorite ? Icons.heart : Glyphs.heart-outline;
        color: root.is-favorite ? Theme.danger : (touch.has-hover ? Theme.foreground : Theme.muted);
        width: 16px;
        height: 16px;
    }

    TooltipAnchor {
        x: 4px;
        width: 24px;
        text: root.is-favorite ? @tr("Remove from favorites") : @tr("Add to favorites");
        is-hovered: touch.has-hover;
    }

    touch := TouchArea {
        x: 4px;
        width: 24px;
        mouse-cursor: pointer;
        clicked => {
            root.toggle();
        }
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
}

export component RatingCell inherits Rectangle {
    in property <int> rating;
    callback rate(rating: int);
    callback context-menu(window-x: length, window-y: length);
    property <int> hovered: -1;

    HorizontalLayout {
        x: 6px;
        alignment: start;

        for star-index in 5: Rectangle {
            width: 17px;

            Icon {
                path: Glyphs.star;
                color: (root.hovered >= 0 ? star-index <= root.hovered : star-index < root.rating) ? (root.hovered >= 0 ? Theme.foreground : Theme.muted) : Theme.tint.with-alpha(26 / 255);
                width: 15px;
                height: 15px;
            }

            TooltipAnchor {
                text: star-index + 1 == root.rating ? @tr("Clear rating") : @tr("Rate {n} star" | "Rate {n} stars" % (star-index + 1));
                is-hovered: star-touch.has-hover;
            }

            star-touch := TouchArea {
                mouse-cursor: pointer;
                changed has-hover => {
                    if (self.has-hover) {
                        root.hovered = star-index;
                    } else if (root.hovered == star-index) {
                        root.hovered = -1;
                    }
                }
                clicked => {
                    root.rate(star-index + 1 == root.rating ? 0 : star-index + 1);
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down && event.button == PointerEventButton.right) {
                        root.context-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
            }
        }
    }
}

export component Skeleton inherits Rectangle {
    height: 10px;
    border-radius: 5px;
    background: Theme.surface-raised;
}
