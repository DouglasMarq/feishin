    pure public function is-outlined(path: string) -> bool {
        return path == self.shuffle || path == self.repeat || path == self.repeat-one || path == self.volume || path == self.volume-off;
    }
}

export global Format {
    pure public function time(ms: int) -> string {
        return Math.floor(ms / 60000) + ":" + (Math.mod(Math.floor(ms / 1000), 60) < 10 ? "0" : "") + Math.mod(Math.floor(ms / 1000), 60);
    }
}
