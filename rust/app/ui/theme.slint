import { Palette } from "std-widgets.slint";
import { Palettes, ThemePalette } from "theme_palettes.slint";

export { Palettes, ThemePalette }

export global Theme {
    in-out property <int> palette-index: 0;
    in-out property <bool> has-custom-accent;
    in-out property <color> accent: #3574fc;
    property <ThemePalette> palette: Palettes.all[palette-index];
    out property <bool> is-dark: palette.is-dark;
    out property <color> background: palette.background;
    out property <color> background-alt: palette.background-alt;
    out property <color> surface: palette.surface;
    out property <color> surface-raised: palette.surface-raised;
    out property <color> border: palette.border;
    out property <color> foreground: palette.foreground;
    out property <color> muted: palette.muted;
    out property <color> primary: has-custom-accent ? accent : palette.primary;
    out property <color> on-primary: primary.to-oklch().lightness > 0.65 ? #141414 : #ffffff;
    out property <color> danger: palette.danger;
    out property <color> tint: is-dark ? #ffffff : #000000;
    out property <color> hover: tint.with-alpha(15 / 255);
    out property <color> selected: primary.with-alpha(41 / 255);
    out property <length> radius: 6px;
    out property <length> radius-card: 8px;
    out property <length> radius-panel: 10px;
    out property <length> panel-gap: 8px;
    out property <color> canvas: is-dark ? palette.background-alt.mix(#000000, 0.5) : palette.background.mix(palette.foreground, 0.92);
    out property <color> panel: is-dark ? palette.background.mix(palette.foreground, 0.955) : palette.background.mix(#ffffff, 0.5);
    out property <color> shadow: is-dark ? #000000b3 : #00000038;
    out property <brush> placeholder: @linear-gradient(135deg, primary.mix(surface-raised, 0.3) 0%, surface-raised 100%);

    pure public function ambient(tint: color) -> color {
        return oklch(root.is-dark ? 0.4 : 0.86, min(tint.to-oklch().chroma, root.is-dark ? 0.12 : 0.08), tint.to-oklch().hue, 1);
    }

    pure public function ambient-glow(tint: color) -> color {
        return oklch(root.is-dark ? 0.5 : 0.9, min(tint.to-oklch().chroma, root.is-dark ? 0.16 : 0.1), tint.to-oklch().hue + 40, 1);
    }

    public function apply(index: int, is-custom-accent-used: bool, accent-color: color) {
        self.palette-index = index;
        self.has-custom-accent = is-custom-accent-used;
        self.accent = accent-color;
        Palette.color-scheme = Palettes.all[index].is-dark ? ColorScheme.dark : ColorScheme.light;
    }
}

export global Typography {
    out property <length> display: 44px;
    out property <length> title: 28px;
    out property <length> heading: 20px;
    out property <length> body: 13px;
    out property <length> small: 12px;
    out property <length> caption: 11px;
    out property <length> caption-spacing: 0.8px;
    out property <int> display-weight: 800;
    out property <int> title-weight: 700;
}

export global Motion {
    out property <duration> quick: 120ms;
    out property <duration> page: 160ms;
    out property <duration> ambient: 600ms;
}

export global Behaviour {
    out property <int> max-volume: 100;
    out property <int> volume-step: 5;
    out property <duration> status-dismiss-delay: 6s;
    out property <length> drag-threshold: 6px;
    out property <duration> tooltip-delay: 450ms;
    out property <duration> bar-settle-timeout: 1500ms;
    out property <duration> bar-scroll-timeout: 800ms;
    out property <int> collapsed-top-songs: 5;
}

