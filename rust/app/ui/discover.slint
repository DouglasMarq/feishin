import { Theme } from "theme.slint";
import { AppState } from "globals.slint";
import { Icon, IconButton, SearchField, TooltipAnchor, TooltipComboBox } from "widgets.slint";
import { DiscoverIcons, DiscoverNotice, DiscoverSection, DiscoverState } from "discover_state.slint";
import { DiscoverShelfView, MoodGrid, SkeletonShelf } from "discover_cards.slint";
import { DiscoverCollectionPage } from "discover_page.slint";

export { DiscoverIcons, DiscoverState } from "discover_state.slint";

component SectionTab inherits Rectangle {
    in property <string> text;
    in property <DiscoverSection> section;
    property <bool> is-active: DiscoverState.section == root.section;
    height: 32px;
    width: label.preferred-width + 28px;
    border-radius: 16px;
    background: root.is-active ? Theme.foreground : (touch.has-hover ? Theme.surface-raised : Theme.surface);

    label := Text {
        text: root.text;
        color: root.is-active ? Theme.background : Theme.foreground;
        font-weight: 600;
        vertical-alignment: center;
    }

    TooltipAnchor {
        text: root.is-active ? @tr("{} is shown", root.text) : @tr("Show {}", root.text);
        is-hovered: touch.has-hover;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            DiscoverState.select-section(root.section);
        }
    }
}

component ActionChip inherits Rectangle {
    in property <string> text;
    in property <string> tooltip;
    callback clicked();
    height: 32px;
    width: label.preferred-width + 28px;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.border;
    background: touch.has-hover ? Theme.hover : transparent;

    label := Text {
        text: root.text;
        color: Theme.foreground;
        vertical-alignment: center;
    }

    TooltipAnchor {
        text: root.tooltip;
        is-hovered: touch.has-hover;
    }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component CountryPicker inherits HorizontalLayout {
    property <string> country: DiscoverState.countries[DiscoverState.country-index];
    spacing: 10px;
    alignment: start;

    Text {
        text: @tr("Country");
        color: Theme.muted;
        vertical-alignment: center;
    }

    TooltipComboBox {
        y: (parent.height - self.height) / 2;
        width: 240px;
        tooltip: @tr("Showing the charts for {}", root.country);
        model: DiscoverState.countries;
        current-index <=> DiscoverState.country-index;
        selected => {
            DiscoverState.select-country(self.current-index);
        }
    }
}

component SectionHeader inherits VerticalLayout {
    spacing: 16px;

    HorizontalLayout {
        spacing: 12px;

        Text {
            text: @tr("Discover");
            font-size: 24px;
            font-weight: 700;
            color: Theme.foreground;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        search := SearchField {
            width: 280px;
            placeholder-text: @tr("Search songs on YouTube Music");
            text <=> DiscoverState.search-text;
            accepted => {
                DiscoverState.search(self.text);
            }
        }

        IconButton {
            y: (parent.height - self.height) / 2;
            icon: DiscoverIcons.refresh;
            is-enabled: !DiscoverState.is-loading;
            tooltip: DiscoverState.is-loading ? @tr("Loading...") : @tr("Refresh this section");
            clicked => {
                DiscoverState.refresh();
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;

        SectionTab {
            text: @tr("For you");
            section: DiscoverSection.for-you;
        }

        SectionTab {
            text: @tr("New releases");
            section: DiscoverSection.new-releases;
        }

        SectionTab {
            text: @tr("Charts");
            section: DiscoverSection.charts;
        }

        SectionTab {
            text: @tr("Moods and genres");
            section: DiscoverSection.moods;
        }
    }

    if DiscoverState.section == DiscoverSection.charts: CountryPicker {
        height: 32px;
    }

    if DiscoverState.notice != "": Text {
        text: DiscoverState.notice;
        color: DiscoverState.notice-kind == DiscoverNotice.warning ? #e8b04a : Theme.muted;
        font-size: 12px;
        wrap: word-wrap;
    }
}

component SectionsPage inherits Rectangle {
    property <bool> is-showing-moods: DiscoverState.section == DiscoverSection.moods;
    property <bool> is-empty: !DiscoverState.is-loading && DiscoverState.error == "" && DiscoverState.shelves.length == 0;

    page := Flickable {
        content-width: self.width;
        content-height: content.preferred-height;

        content := VerticalLayout {
            width: page.width;
            padding: 20px;
            padding-bottom: 32px;
            spacing: 24px;
            alignment: start;

            SectionHeader { }

            if root.is-showing-moods: MoodGrid {
                moods: DiscoverState.moods;
                selected: DiscoverState.mood-index;
            }

            if DiscoverState.error != "": VerticalLayout {
                spacing: 12px;
                alignment: start;

                Text {
                    text: DiscoverState.error;
                    color: Theme.danger;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    alignment: start;

                    ActionChip {
                        text: @tr("Try again");
                        tooltip: @tr("Load this section again");
                        clicked => {
                            DiscoverState.refresh();
                        }
                    }
                }
            }

            if DiscoverState.is-loading && DiscoverState.shelves.length == 0: VerticalLayout {
                spacing: 28px;

                for _ in 3: SkeletonShelf { }
            }

            if root.is-empty && root.is-showing-moods && DiscoverState.mood-index < 0 && DiscoverState.moods.length > 0: Text {
                text: @tr("Pick a mood or genre to see its playlists");
                color: Theme.muted;
            }

            if root.is-empty && !(root.is-showing-moods && DiscoverState.mood-index < 0): Text {
                text: @tr("Nothing to show here right now");
                color: Theme.muted;
            }

            for shelf[shelf-index] in DiscoverState.shelves: DiscoverShelfView {
                shelf: shelf;
                index: shelf-index;
                is-on-screen: self.y + page.content-y + self.height > 0 && self.y + page.content-y < page.height;
            }
        }
    }

    if DiscoverState.is-loading && DiscoverState.shelves.length > 0: Rectangle {
        y: 0;
        height: 2px;
        background: Theme.primary;
    }
}

export component DiscoverView inherits Rectangle {
    property <string> id: AppState.detail-id;
    min-width: 320px;
    background: Theme.panel;

    init => {
        DiscoverState.open(root.id);
    }

    changed id => {
        DiscoverState.open(root.id);
    }

    if root.id == "": SectionsPage { }

    if root.id != "": DiscoverCollectionPage { }
}
