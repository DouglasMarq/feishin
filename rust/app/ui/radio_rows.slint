import { Theme, Icons } from "theme.slint";
import { IconButton, TooltipAnchor } from "widgets.slint";
import { RadioIcons } from "radio_widgets.slint";

export enum RadioSource { server, favorite, directory }

export enum RadioTab { stations, directory }

export struct RadioRow {
    id: string,
    name: string,
    details: string,
    source: RadioSource,
    is-favorite: bool,
    is-on-server: bool,
}

export global RadioState {
    in property <bool> is-active;
    in property <string> playing-id;
    in property <string> station-name;
    in property <string> stream-title;
    in-out property <RadioTab> tab;
    in property <[RadioRow]> stations;
    in property <bool> is-stations-loading;
    in property <bool> can-manage;
    in property <bool> has-server-radio: true;
    in property <[RadioRow]> results;
    in property <bool> is-searching;
    in property <bool> has-more;
    in property <string> results-message: @tr("Find stations by name, country or tag");
    in-out property <string> search-name;
    in-out property <string> search-country;
    in-out property <string> search-tag;
    in property <bool> is-busy;
    in-out property <bool> is-editing;
    in-out property <string> edit-id;
    in-out property <RadioSource> edit-source;
    in-out property <string> edit-name;
    in-out property <string> edit-url;
    in-out property <string> edit-homepage;
    in-out property <string> edit-error;
    in-out property <string> delete-id;
    in-out property <string> delete-name;
    callback load();
    callback play(RadioSource, string);
    callback stop();
    callback toggle-favorite(RadioSource, string);
    callback save-to-server(RadioSource, string);
    callback edit(RadioSource, string);
    callback delete(string);
    callback search();
    callback load-more();
    callback save-edit(RadioSource);
}

component PlayStationButton inherits IconButton {
    in property <RadioRow> item;
    property <bool> is-playing: RadioState.is-active && RadioState.playing-id == root.item.id;
    icon: root.is-playing ? RadioIcons.stop : Icons.play;
    is-active: root.is-playing;
    tooltip: root.is-playing ? @tr("Stop {}", root.item.name) : @tr("Play {}", root.item.name);
    clicked => {
        if (root.is-playing) {
            RadioState.stop();
        } else {
            RadioState.play(root.item.source, root.item.id);
        }
    }
}

component StationActions inherits HorizontalLayout {
    in property <RadioRow> item;
    property <bool> is-local: root.item.source != RadioSource.server;
    spacing: 2px;
    alignment: end;

    PlayStationButton {
        y: (parent.height - self.height) / 2;
        item: root.item;
    }

    if root.is-local: IconButton {
        y: (parent.height - self.height) / 2;
        icon: root.item.is-favorite ? Icons.heart : RadioIcons.heart-outline;
        icon-size: 18px;
        is-active: root.item.is-favorite;
        tooltip: root.item.is-favorite ? @tr("Saved on this device, click to remove") : @tr("Save to favorites on this device");
        clicked => {
            RadioState.toggle-favorite(root.item.source, root.item.id);
        }
    }

    if root.is-local && RadioState.can-manage: IconButton {
        y: (parent.height - self.height) / 2;
        icon: RadioIcons.upload;
        icon-size: 18px;
        is-enabled: !root.item.is-on-server && !RadioState.is-busy;
        tooltip: root.item.is-on-server ? @tr("Already on the server") : RadioState.is-busy ? @tr("Saving to the server...") : @tr("Add to the server's stations");
        clicked => {
            RadioState.save-to-server(root.item.source, root.item.id);
        }
    }

    if root.item.source == RadioSource.favorite || (root.item.source == RadioSource.server && RadioState.can-manage): IconButton {
        y: (parent.height - self.height) / 2;
        icon: RadioIcons.edit;
        icon-size: 18px;
        tooltip: @tr("Edit {}", root.item.name);
        clicked => {
            RadioState.edit(root.item.source, root.item.id);
        }
    }

    if root.item.source == RadioSource.server && RadioState.can-manage: IconButton {
        y: (parent.height - self.height) / 2;
        icon: Icons.close;
        icon-size: 18px;
        tooltip: @tr("Delete {} from the server", root.item.name);
        clicked => {
            RadioState.delete-name = root.item.name;
            RadioState.delete-id = root.item.id;
        }
    }
}

export component RadioRowView inherits Rectangle {
    in property <RadioRow> item;
    property <bool> is-playing: RadioState.is-active && RadioState.playing-id == root.item.id;
    height: 56px;
    background: touch.has-hover ? Theme.hover : transparent;

    touch := TouchArea {
        double-clicked => {
            RadioState.play(root.item.source, root.item.id);
        }
    }

    TooltipAnchor {
        text: @tr("Double-click to play");
        is-hovered: touch.has-hover;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 12px;
        spacing: 12px;

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;

            Text {
                text: root.item.name;
                color: root.is-playing ? Theme.primary : Theme.foreground;
                font-weight: 600;
                overflow: elide;
            }

            Text {
                text: root.item.details;
                color: Theme.muted;
                font-size: 12px;
                overflow: elide;
            }
        }

        StationActions {
            item: root.item;
        }
    }
}
